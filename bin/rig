#!/usr/bin/env bash
set -euo pipefail

_RIG_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_RIG_DETECT=""
if [[ -f "$_RIG_BIN_DIR/../scripts/detect-binaries.sh" ]]; then
  _RIG_DETECT="$(cd "$_RIG_BIN_DIR/../scripts" && pwd)/detect-binaries.sh"
elif [[ -f "${RIG_HOME:-$HOME/.rig}/scripts/detect-binaries.sh" ]]; then
  _RIG_DETECT="${RIG_HOME:-$HOME/.rig}/scripts/detect-binaries.sh"
else
  echo "rig: cannot find scripts/detect-binaries.sh" >&2
  exit 1
fi
# shellcheck source=../scripts/detect-binaries.sh
source "$_RIG_DETECT"

usage() {
  cat <<'EOF'
usage: rig <command> [args]

  setup
  update
  init [--patch-agents|--no-patch-agents] [--patch-claude]
  doctor
  status
  use codex|grok|opencode|omp|pi|agy
  workers grok=on|off claude=on|off codex=on|off cursor=on|off opencode=on|off omp=on|off pi=on|off agy=on|off
  prune
  run "prompt"
  jobs [--json] [--thread [ID]]
  tui
  memory [show]
  memory add "standing fact"
  job start [--worker NAME] [--role ROLE] [id]
  job finish <id> [--status ok|fail] [--summary TEXT]
  job record [--worker NAME] [--role ROLE] [--status ok|fail] [--summary TEXT] [id]
  job show [id]
  job log [id] [-f] [-n N]
  job allow [id]
  job deny [id] [--reason TEXT]
  job wait [id] [--timeout SECS]
  pick [explore|mini|bulk|implement|hard|review|stay] [--case TEXT] [--json]

Stay in Codex, Grok, OpenCode, OMP, Pi, or agy. They can invoke Claude, Cursor, OpenCode, OMP, Pi, agy, or each other.
EOF
  exit 2
}

rig_source_root() {
  if [[ -n "${RIG_SRC:-}" && -f "$RIG_SRC/bin/rig" ]]; then
    printf '%s\n' "$RIG_SRC"
    return 0
  fi
  local root
  root="$(cd "$_RIG_BIN_DIR/.." && pwd)"
  if [[ -f "$root/skills/delegate-harness/SKILL.md" ]]; then
    printf '%s\n' "$root"
    return 0
  fi
  printf '%s\n' "$(rig_home)"
}

install_file() {
  local srcf="$1" destf="$2"
  local tmp
  tmp="$(mktemp "${destf}.XXXXXX")"
  cp "$srcf" "$tmp"
  mv "$tmp" "$destf"
}

copy_rig_tree() {
  local src="$1" dest="$2"
  mkdir -p "$dest"/{bin,scripts,skills,adapters/codex/agents,adapters/grok,adapters/claude,adapters/cursor,adapters/opencode,adapters/omp,adapters/pi,adapters/agy,templates}
  if [[ "$(cd "$src" && pwd)" != "$(cd "$dest" && pwd)" ]]; then
    # mv onto dest so a running bin/rig keeps its old inode
    install_file "$src/bin/rig" "$dest/bin/rig"
    local f skill
    for f in "$src/scripts/"*; do
      [[ -f "$f" ]] || continue
      install_file "$f" "$dest/scripts/$(basename "$f")"
    done
    for skill in "$src/skills/"*; do
      [[ -d "$skill" ]] || continue
      mkdir -p "$dest/skills/$(basename "$skill")"
      for f in "$skill/"*; do
        [[ -f "$f" ]] || continue
        install_file "$f" "$dest/skills/$(basename "$skill")/$(basename "$f")"
      done
    done
    for f in "$src/adapters/codex/agents/"*.toml; do
      install_file "$f" "$dest/adapters/codex/agents/$(basename "$f")"
    done
    install_file "$src/adapters/grok/config.toml.snippet" "$dest/adapters/grok/config.toml.snippet"
    install_file "$src/adapters/claude/CLAUDE.worker.md" "$dest/adapters/claude/CLAUDE.worker.md"
    if [[ -f "$src/adapters/cursor/CURSOR.worker.md" ]]; then
      install_file "$src/adapters/cursor/CURSOR.worker.md" "$dest/adapters/cursor/CURSOR.worker.md"
    fi
    if [[ -f "$src/adapters/opencode/OPENCODE.worker.md" ]]; then
      install_file "$src/adapters/opencode/OPENCODE.worker.md" "$dest/adapters/opencode/OPENCODE.worker.md"
    fi
    if [[ -f "$src/adapters/omp/OMP.worker.md" ]]; then
      install_file "$src/adapters/omp/OMP.worker.md" "$dest/adapters/omp/OMP.worker.md"
    fi
    if [[ -f "$src/adapters/pi/PI.worker.md" ]]; then
      install_file "$src/adapters/pi/PI.worker.md" "$dest/adapters/pi/PI.worker.md"
    fi
    if [[ -f "$src/adapters/agy/AGY.worker.md" ]]; then
      install_file "$src/adapters/agy/AGY.worker.md" "$dest/adapters/agy/AGY.worker.md"
    fi
    for f in "$src/templates/"*; do
      [[ -f "$f" ]] || continue
      install_file "$f" "$dest/templates/$(basename "$f")"
    done
  fi
  chmod +x "$dest/bin/rig" "$dest/scripts/"*.sh "$dest/scripts/"*.py 2>/dev/null || true
  if git -C "$src" rev-parse --short HEAD >/dev/null 2>&1; then
    printf 'v1 %s\n' "$(git -C "$src" rev-parse --short HEAD)" > "$dest/VERSION"
  else
    printf 'v1\n' > "$dest/VERSION"
  fi
}

py_script() {
  local name="$1" p
  p="$(rig_home)/scripts/$name"
  if [[ -f "$p" ]]; then
    printf '%s\n' "$p"
    return 0
  fi
  printf '%s\n' "$(rig_source_root)/scripts/$name"
}

ensure_skill_link() {
  local dest="$1" src="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    ln -sfn "$src" "$dest"
    printf 'linked %s\n' "$dest"
  elif [[ -e "$dest" ]]; then
    printf 'skip %s (exists, not a symlink)\n' "$dest"
  else
    ln -sfn "$src" "$dest"
    printf 'linked %s\n' "$dest"
  fi
}

maybe_copy_codex_agent() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -e "$dest" ]]; then
    if command grep -q "You are a Rig" "$dest" 2>/dev/null; then
      install_file "$src" "$dest"
      printf 'refreshed %s\n' "$dest"
      return 0
    fi
    printf 'skip %s (exists, not a Rig agent)\n' "$dest"
    return 0
  fi
  cp "$src" "$dest"
  printf 'wrote %s\n' "$dest"
}

cmd_setup() {
  local src dest
  src="$(rig_source_root)"
  dest="$(rig_home)"
  if [[ ! -f "$src/bin/rig" || ! -f "$src/skills/delegate-harness/SKILL.md" ]]; then
    echo "rig setup: source tree not found at $src" >&2
    echo "set RIG_SRC to the Rig clone and retry" >&2
    exit 1
  fi
  copy_rig_tree "$src" "$dest"
  mkdir -p "$HOME/.agents/skills" "$HOME/.grok/skills" "$HOME/.codex/agents" "$HOME/.codex/skills" \
    "$HOME/.config/opencode/skill" "$HOME/.omp/agent/skills" "$HOME/.pi/agent/skills" \
    "$HOME/.gemini/antigravity-cli/skills"
  local skill
  for skill in delegate-harness rig-jobs; do
    ensure_skill_link "$HOME/.agents/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.grok/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.codex/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.config/opencode/skill/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.omp/agent/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.pi/agent/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.gemini/antigravity-cli/skills/$skill" "$dest/skills/$skill"
  done

  local name
  for name in explorer worker bulk reviewer; do
    maybe_copy_codex_agent \
      "$dest/adapters/codex/agents/${name}.toml" \
      "$HOME/.codex/agents/${name}.toml"
  done

  local codex_cfg="$HOME/.codex/config.toml"
  if [[ -f "$codex_cfg" ]]; then
    if ! rig_has_top_key "$codex_cfg" "model"; then
      rig_set_toml_key "$codex_cfg" "" "model" '"gpt-5.6-sol"'
      echo "set ~/.codex/config.toml model = \"gpt-5.6-sol\" (was missing)"
    fi
    if ! rig_has_section_key "$codex_cfg" "agents" "default_subagent_model"; then
      rig_set_toml_key "$codex_cfg" "agents" "default_subagent_model" '"gpt-5.6-terra"'
      echo "set ~/.codex/config.toml [agents] default_subagent_model = \"gpt-5.6-terra\" (was missing)"
    fi
    sandbox_fix="$(rig_ensure_codex_child_sandbox "$codex_cfg")"
    if [[ "$sandbox_fix" != "keep" ]]; then
      echo "set ~/.codex/config.toml [sandbox_workspace_write] ($sandbox_fix) so Grok/Claude/Cursor/OpenCode/OMP/Pi/agy children can write sessions"
    fi
  fi

  local grok_cfg="$HOME/.grok/config.toml"
  if [[ -f "$grok_cfg" ]]; then
    if ! rig_has_section_key "$grok_cfg" "subagents.models" "explore"; then
      rig_set_toml_key "$grok_cfg" "subagents.models" "explore" '"grok-4.5"'
      echo "set ~/.grok/config.toml [subagents.models] explore = \"grok-4.5\" (was missing)"
    fi
  fi

  local ui_py
  ui_py="$(py_script install-ui.py)"
  if [[ -f "$ui_py" ]]; then
    python3 "$ui_py" "$dest"
  fi

  echo "setup ok  RIG_HOME=$dest"
  echo "watch: rig tui   |   rig jobs   |   /rig in Grok, Codex, OpenCode, OMP, Pi, or agy"
  echo "next: in a repo, run: rig init && rig doctor"
}

cmd_update() {
  if [[ -n "${RIG_LIVE:-}" ]]; then
    echo "rig update: refuse inside a worker" >&2
    exit 1
  fi
  local url dest tmp rc
  url="${RIG_INSTALL_SH:-https://raw.githubusercontent.com/Brasth/Rig/main/install.sh}"
  if [[ "$url" != *://* && -f "$url" ]]; then
    url="file://${url}"
  fi
  dest="$(rig_home)"
  if ! command -v curl >/dev/null 2>&1; then
    echo "rig update: curl not found" >&2
    exit 1
  fi
  tmp="$(mktemp)"
  if ! command curl -fsSL "$url" -o "$tmp"; then
    rm -f "$tmp"
    echo "rig update: could not fetch installer from $url" >&2
    exit 1
  fi
  if [[ ! -s "$tmp" ]]; then
    rm -f "$tmp"
    echo "rig update: installer empty from $url" >&2
    exit 1
  fi
  set +e
  RIG_HOME="$dest" bash "$tmp"
  rc=$?
  set -e
  rm -f "$tmp"
  if [[ "$rc" -ne 0 ]]; then
    echo "rig update: installer failed ($rc)" >&2
    exit "$rc"
  fi
  echo "kit is at $dest"
  echo "fully quit the parent CLI once if MCP/skills changed"
}

ensure_harness() {
  local root templates harness
  root="$(repo_root)"
  templates="$(rig_home)/templates"
  if [[ ! -d "$templates" ]]; then
    templates="$(rig_source_root)/templates"
  fi
  mkdir -p "$root/.rig/jobs"
  harness="$root/.rig/harness.toml"
  if [[ ! -f "$harness" ]]; then
    if [[ ! -f "$templates/harness.toml" ]]; then
      echo "rig: templates not found; run: rig setup" >&2
      exit 1
    fi
    cp "$templates/harness.toml" "$harness"
  fi
}

cmd_init() {
  local patch_agents=1 patch_claude=0 arg
  for arg in "$@"; do
    case "$arg" in
      --patch-agents) patch_agents=1 ;;
      --no-patch-agents) patch_agents=0 ;;
      --patch-claude) patch_claude=1 ;;
      *)
        echo "rig init: unknown flag $arg" >&2
        usage
        ;;
    esac
  done

  local root templates
  root="$(repo_root)"
  templates="$(rig_home)/templates"
  if [[ ! -f "$templates/harness.toml" ]]; then
    templates="$(rig_source_root)/templates"
  fi
  if [[ ! -f "$templates/harness.toml" ]]; then
    echo "rig init: templates not found; run: rig setup" >&2
    exit 1
  fi

  mkdir -p "$root/.rig/jobs"
  local f harness harness_new=0
  harness="$root/.rig/harness.toml"
  for f in harness.toml MEMORY.md STATE.md; do
    if [[ -f "$root/.rig/$f" ]]; then
      printf 'keep %s\n' "$root/.rig/$f"
    else
      cp "$templates/$f" "$root/.rig/$f"
      printf 'wrote %s\n' "$root/.rig/$f"
      [[ "$f" == "harness.toml" ]] && harness_new=1
    fi
  done
  if [[ "$harness_new" -eq 1 ]]; then
    local name flag
    for name in "${RIG_WORKERS[@]}"; do
      [[ "$name" == "codex" ]] && continue
      if [[ -n "$(find_worker_bin "$name")" ]]; then
        flag=true
      else
        flag=false
      fi
      rig_set_toml_key "$harness" "workers" "$name" "$flag"
    done
    echo "workers from PATH: grok=$(worker_flag grok) claude=$(worker_flag claude) cursor=$(worker_flag cursor) opencode=$(worker_flag opencode) omp=$(worker_flag omp) pi=$(worker_flag pi) agy=$(worker_flag agy)"
  elif [[ -f "$harness" ]]; then
    local name
    for name in "${RIG_WORKERS[@]}"; do
      if ! rig_has_section_key "$harness" "workers" "$name"; then
        rig_set_toml_key "$harness" "workers" "$name" "false"
        echo "appended $name = false (existing harness; run: rig workers $name=on)"
      fi
    done
  fi

  # Codex loads repo skills from .agents/skills. Refresh SKILL.md on each init.
  local skill_name skill_src dest_skill
  for skill_name in delegate-harness rig-jobs; do
    skill_src="$(rig_home)/skills/${skill_name}/SKILL.md"
    if [[ ! -f "$skill_src" ]]; then
      skill_src="$(rig_source_root)/skills/${skill_name}/SKILL.md"
    fi
    dest_skill="$root/.agents/skills/${skill_name}"
    mkdir -p "$dest_skill"
    if [[ -f "$skill_src" ]]; then
      cp "$skill_src" "$dest_skill/SKILL.md"
      printf 'wrote %s\n' "$dest_skill/SKILL.md"
    fi
  done

  local gi="$root/.gitignore" frag
  for frag in ".rig/jobs/" ".rig/thread"; do
    if [[ -f "$gi" ]]; then
      if command grep -qxF "$frag" "$gi" 2>/dev/null; then
        printf 'keep %s (%s)\n' "$gi" "$frag"
      else
        printf '\n%s\n' "$frag" >> "$gi"
        printf 'appended %s to %s\n' "$frag" "$gi"
      fi
    fi
  done

  if [[ "$patch_agents" -eq 1 ]]; then
    local agents="$root/AGENTS.md"
    local block action
    block="$(cat <<'EOF'
<!-- rig:start -->
MUST use Rig. Load `.agents/skills/delegate-harness/SKILL.md`. This CLI is the parent. Doing worker work yourself is a failure.
Later AGENTS.md may say "edit locally" or "SSH to the VM". That is for the worker, not you.

Keep: plan, check, ask, advise, vision, computer-use, chrome-profile, talk to the user, read `rig jobs` / `rig memory`.
Ask / plan / advise → stay (parent). Docs/skills-only → `rig pick mini`.
Parent checks first (read the code, name the update).
Spawn explore/mini for codebase gather only if the parent cannot name the files after a short check.
If the implement brief already lists files, do not also spawn explore.
Brief lists files and the change. Child does not hunt extra updates.
Spawn for: write of the listed files, review, SSH/debug. Not "find the bug" on an implement spawn.
Parent chooses kind from this user request and this user skills. Then `rig pick stay` / `explore` / `mini` / `implement` / `hard` / `review` (MCP: `rig_pick` with `role`). `--case` is the task text, not a slash-command catalog.
Do not encode local slash command names in pick.
Model/effort still come from pick JSON. Parent does not shop models.

1. MCP `rig_memory` then `rig_jobs` then `rig_status` then `rig_pick` when MCP is present. Bash fallback if MCP missing: `rig memory` then `rig jobs` then `rig status` then `rig pick implement --case "<task>" --json` or `rig pick stay --case "<task>" --json`. `rig pick --case "<task>" --json` if you did not choose a kind.
2. Follow pick JSON — do not ask the user which model
Follow pick JSON; never spawn a worker whose harness flag is false; never spawn grok when workers.grok is false unless live parent is grok (native). Timeout/fail does not unlock a disabled worker.
3. stay → you do it (ask / plan / advise / vision / computer-use / chrome-profile). Spawn only if this CLI cannot.
4. native → cheap same-CLI agent, then MCP `rig_job_start` / `rig_job_finish` / `rig_job_record` when present, else `rig job start` / `rig job finish`
5. run-worker → write `.rig/jobs/<id>/brief.md` then start the wrapper in the background (do not block this turn on it):
   `RIG_LIVE=1 RIG_ROLE=<kind> RIG_MODEL=<model> RIG_EFFORT=<effort> "$HOME/.rig/scripts/run-worker.sh" <worker> <id> .rig/jobs/<id>/brief.md`
   Prefer MCP when present: `rig_jobs` / `rig_job_show` / `rig_job_log` / `rig_job_wait` / `rig_job_allow` / `rig_job_deny` / `rig_memory` / `rig_pick` / `rig_status` / `rig_job_start` / `rig_job_finish` / `rig_job_record`. Wait = one blocking `rig_job_wait` with no timeout. Bash fallback if MCP missing: one `rig job wait <id>` with no `--timeout`.
   Do not spawn via MCP. Launching a child is still bash `run-worker.sh`.
   If MCP wait errors or the host drops the tool, bash `rig job wait <id>` once (no `--timeout`). Do not poll 30s.
   Do not parse a TUI.
   wait exit 2 / status ask: YOU answer `rig job allow <id>` or `rig job deny <id>`. Safe worker work (read/edit/test/ssh gather/git) → allow. Destructive/prod/secrets → deny or ask the user.
   Then wait once more (no timeout). exit 0 ok, exit 1 fail.
   Never kill, close, or finish an asking job. Never spawn another worker because the child asked. The child is waiting on you.

Live parent is this CLI, not the `parent` key (`rig use grok|codex|opencode|omp|pi|agy` is only the preferred default).
Claude Code and Cursor CLI are never the parent. OpenCode, OMP, Pi, and agy can be the parent when you open that CLI. Worker on only if flag + binary + not live parent. Cursor binary is `cursor-agent`. Missing binary: that worker is off. Cheap same-CLI is success.
Implement: Grok child if effective. If this CLI is Codex, Grok, OpenCode, OMP, Pi, or agy: Claude if effective, else cheap same-CLI. Do not spawn Cursor/Codex/OpenCode/OMP/Pi/agy just because their CLI is on PATH. If both OMP and Pi are on, pick OMP.
When live parent is agy, do not use nested agy /agent dispatch for coding; use `rig pick`.
Pin Claude IDs: `claude-haiku-4-5-20251001` cheap, `claude-sonnet-5` implement, `claude-opus-5` hard/review. Cursor: `composer-2.5-fast` cheap, `composer-2.5` implement, `cursor-grok-4.6-high` hard, `claude-opus-5-thinking-high` review.
OpenCode: `openai/gpt-5.4-mini` minimal cheap, `openai/gpt-5.6-luna` high implement, `openai/gpt-5.6-terra` max hard/review. OMP/Pi: `grok-4.5` low cheap, `grok-4.6` high implement/hard, `claude-opus-5` high review. agy: `gemini-3.8-flash-low` low cheap, `gemini-3.8-flash-high` high implement, `gemini-3.1-pro-high` high hard/review. Never Sol/Astra/Fable as a child. Opus is allowed.
OpenCode/OMP/Pi/agy pins are preferences; Rig lists models from the CLI and picks one that exists. Cache ~/.rig/cache/model-catalogs.json.
Grok Bot.app is not a worker. Do not spawn it.
Watch: `rig jobs` / `rig job wait <id>` / `rig job show` / `rig job log <id>` / `rig tui` / `/rig`.
After a run: `rig memory add "one standing fact"` if there is one. No transcripts.
<!-- rig:end -->
EOF
)"
    action="$(rig_upsert_marked_block "$agents" "<!-- rig:start -->" "<!-- rig:end -->" "$block")"
    echo "$action $agents"
  fi

  if [[ "$patch_claude" -eq 1 ]]; then
    local claude="$root/CLAUDE.md"
    local stub
    stub="$(rig_home)/adapters/claude/CLAUDE.worker.md"
    if [[ ! -f "$stub" ]]; then
      stub="$(rig_source_root)/adapters/claude/CLAUDE.worker.md"
    fi
    if [[ -f "$claude" ]]; then
      echo "keep $claude (exists)"
    else
      cp "$stub" "$claude"
      echo "wrote $claude"
    fi
  fi

  echo "init ok  $root/.rig"
}

worker_reason() {
  local name="$1"
  local flag bin live
  flag="$(worker_flag "$name")"
  bin="$(find_worker_bin "$name")"
  live="$(live_parent)"
  if [[ "$flag" != "true" ]]; then
    printf '%s\n' "flag"
  elif [[ -z "$bin" ]]; then
    printf '%s\n' "no binary"
  elif [[ "$name" == "$live" ]]; then
    printf '%s\n' "is live parent"
  else
    printf '%s\n' ""
  fi
}

# Fail open: empty stdout if git/network/timeout.
doctor_remote_main_sha() {
  local url="$1"
  python3 - "$url" <<'PY' 2>/dev/null
import os, subprocess, sys

url = sys.argv[1]
env = os.environ.copy()
env["GIT_TERMINAL_PROMPT"] = "0"
try:
    proc = subprocess.run(
        ["git", "ls-remote", url, "refs/heads/main"],
        capture_output=True,
        text=True,
        timeout=5,
        env=env,
    )
except Exception:
    raise SystemExit(1)
if proc.returncode != 0 or not proc.stdout.strip():
    raise SystemExit(1)
print(proc.stdout.split()[0])
PY
}

doctor_print_update() {
  local ver="${1:-}" local_sha remote
  [[ -n "${RIG_SKIP_UPDATE_CHECK:-}" ]] && return 0
  local_sha="$(awk '{print $2}' <<<"$ver")"
  [[ -n "$local_sha" ]] || return 0
  remote="$(doctor_remote_main_sha "${RIG_REPO_URL:-https://github.com/Brasth/Rig.git}")" || return 0
  [[ -n "$remote" ]] || return 0
  if [[ "$remote" == "$local_sha"* ]]; then
    echo "  update:   current"
  else
    echo "  update:   behind main — run: rig update"
  fi
}

cmd_doctor() {
  local dest root harness live pref runw ver
  dest="$(rig_home)"
  root="$(repo_root)"
  harness="$(harness_path)"
  live="$(live_parent)"
  parse_harness "$harness"
  pref="$HARNESS_PARENT"
  runw="$dest/scripts/run-worker.sh"
  if [[ ! -f "$runw" ]]; then
    runw="$(rig_source_root)/scripts/run-worker.sh"
  fi

  echo "Rig doctor"
  echo "  RIG_HOME: $dest"
  echo "  repo:     $root"
  if [[ -f "$harness" ]]; then
    echo "  harness:  $harness"
  else
    echo "  harness:  $harness (missing — run: rig init)"
  fi
  if [[ -f "$dest/VERSION" ]]; then
    ver="$(tr -d '\r\n' < "$dest/VERSION")"
  else
    ver=""
  fi
  if [[ -n "$ver" ]]; then
    echo "  version:  $ver"
  else
    echo "  version:  (unknown — run: rig update)"
  fi
  doctor_print_update "$ver"
  echo
  echo "Parent"
  echo "  live:      ${live:-(none)}"
  echo "  preferred: $pref"
  echo
  echo "Workers"
  local name flag bin reason eff
  for name in "${RIG_WORKERS[@]}"; do
    flag="$(worker_flag "$name")"
    bin="$(find_worker_bin "$name")"
    reason="$(worker_reason "$name")"
    if [[ -z "$reason" ]]; then
      eff="on"
    else
      eff="off"
    fi
    printf '  %-8s flag=%-5s bin=%-42s effective=%s' \
      "$name" "$flag" "${bin:-(missing)}" "$eff"
    if [[ -n "$reason" ]]; then
      printf ' (%s)' "$reason"
    fi
    printf '\n'
  done
  echo
  echo "Apps (not spawnable)"
  local app
  app="$(find_app grok-bot)"
  printf '  %-8s %s\n' "grok-bot" "${app:-(missing)}"
  app="$(find_app cursor)"
  printf '  %-8s %s\n' "cursor" "${app:-(missing)}"
  if [[ -z "$(find_worker_bin cursor)" ]]; then
    echo "  Cursor GUI cannot be spawned. Install CLI:"
    echo "  curl https://cursor.com/install -fsS | bash"
  fi
  if [[ -z "$(find_worker_bin opencode)" ]]; then
    echo "  OpenCode CLI missing:"
    echo "  curl -fsSL https://opencode.ai/install | bash"
  fi
  if [[ -z "$(find_worker_bin omp)" ]]; then
    echo "  OMP CLI missing:"
    echo "  curl -fsSL https://omp.sh/install | sh"
  fi
  if [[ -z "$(find_worker_bin pi)" ]]; then
    echo "  Pi CLI missing:"
    echo "  npm install -g @earendil-works/pi-coding-agent"
  fi
  if [[ -z "$(find_worker_bin agy)" ]]; then
    echo "  Antigravity CLI missing:"
    echo "  curl -fsSL https://antigravity.google/cli/install.sh | bash"
  fi
  echo
  echo "Skill"
  local p proj_skill
  proj_skill="$(repo_root)/.agents/skills/delegate-harness/SKILL.md"
  if [[ -f "$proj_skill" ]]; then
    echo "  project: $proj_skill"
  else
    echo "  project: $proj_skill (missing — run: rig init)"
  fi
  for p in \
    "$HOME/.agents/skills/delegate-harness" \
    "$HOME/.grok/skills/delegate-harness" \
    "$HOME/.codex/skills/delegate-harness" \
    "$HOME/.config/opencode/skill/delegate-harness" \
    "$HOME/.omp/agent/skills/delegate-harness" \
    "$HOME/.pi/agent/skills/delegate-harness" \
    "$HOME/.gemini/antigravity-cli/skills/delegate-harness"
  do
    if [[ -L "$p" ]]; then
      echo "  $p -> $(readlink "$p")"
    elif [[ -e "$p" ]]; then
      echo "  $p (present, not a symlink)"
    else
      echo "  $p (missing — run: rig setup)"
    fi
  done
  echo
  echo "Scripts"
  if [[ -x "$runw" || -f "$runw" ]]; then
    echo "  run-worker: $runw (ok)"
  else
    echo "  run-worker: $runw (missing)"
    echo "Rig itself is broken. Re-run: rig setup" >&2
    exit 1
  fi
  local cat_py cat_out
  cat_py="$(py_script catalog.py)"
  if [[ -f "$cat_py" ]]; then
    cat_out="$(python3 "$cat_py" doctor 2>/dev/null || true)"
    if [[ -n "$cat_out" ]]; then
      echo
      printf '%s\n' "$cat_out"
    fi
  fi
  echo
  echo "MCP"
  local mcp_cfg mcp_label
  for mcp_label in grok codex; do
    if [[ "$mcp_label" == "grok" ]]; then
      mcp_cfg="$HOME/.grok/config.toml"
    else
      mcp_cfg="$HOME/.codex/config.toml"
    fi
    if [[ -f "$mcp_cfg" ]] && command grep -q '^\[mcp_servers\.rig\]' "$mcp_cfg" 2>/dev/null; then
      echo "  $mcp_label: $mcp_cfg [mcp_servers.rig]  (fully quit $mcp_label once to load tools)"
    else
      echo "  $mcp_label: missing — run: rig setup"
    fi
  done
  mcp_cfg="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"
  if [[ -f "$mcp_cfg" ]] && command grep -q 'rig-mcp' "$mcp_cfg" 2>/dev/null; then
    if command grep -q '"servers"' "$mcp_cfg" 2>/dev/null; then
      echo "  opencode: $mcp_cfg mcp.servers.rig  (fully quit opencode once to load tools)"
    else
      echo "  opencode: $mcp_cfg mcp.rig  (fully quit opencode once to load tools)"
    fi
  else
    echo "  opencode: missing — run: rig setup"
  fi
  mcp_cfg="${OMP_MCP:-$HOME/.omp/mcp.json}"
  if [[ -f "$mcp_cfg" ]] && command grep -q 'rig-mcp' "$mcp_cfg" 2>/dev/null; then
    echo "  omp: $mcp_cfg mcpServers.rig  (fully quit omp once to load tools)"
  else
    echo "  omp: missing — run: rig setup"
  fi
  local pi_dir pi_settings
  if [[ -n "${PI_CODING_AGENT_DIR:-}" ]]; then
    pi_dir="$PI_CODING_AGENT_DIR"
  elif [[ -n "${PI_AGENT_DIR:-}" ]]; then
    pi_dir="$PI_AGENT_DIR"
  else
    pi_dir="$HOME/.pi/agent"
  fi
  mcp_cfg="$pi_dir/mcp.json"
  pi_settings="$pi_dir/settings.json"
  if [[ -f "$mcp_cfg" ]] && command grep -q 'rig-mcp' "$mcp_cfg" 2>/dev/null; then
    echo "  pi: $mcp_cfg mcpServers.rig  (fully quit pi once to load tools)"
  else
    echo "  pi: missing — run: rig setup"
  fi
  if ! command grep -q 'pi-mcp-adapter' "$pi_settings" 2>/dev/null; then
    echo "  pi MCP adapter missing — pi install npm:pi-mcp-adapter"
  fi
  mcp_cfg="${AGY_MCP:-$HOME/.gemini/config/mcp_config.json}"
  if [[ -f "$mcp_cfg" ]] && command grep -q 'rig-mcp' "$mcp_cfg" 2>/dev/null; then
    echo "  agy: $mcp_cfg mcpServers.rig  (fully quit agy once to load tools)"
  else
    echo "  agy: missing — run: rig setup"
  fi
  echo
  echo "Watch"
  echo "  board:  rig tui"
  echo "  list:   rig jobs"
  echo "  wait:   rig job wait [id]   (blocks until ASK or result; exit 2 = ASK — you allow/deny)"
  echo "  log:    rig job log [id] -f"
  echo "  memory: rig memory   |   rig memory add \"fact\""
  echo "  slash:  /rig in Grok, Codex, OpenCode, OMP, Pi, or agy"
  echo "  pick:   rig pick --case \"task\"   (agent chooses model; do not ask the user)"
}

cmd_status() {
  local live pref name effs jobs
  parse_harness "$(harness_path)"
  live="$(live_parent)"
  pref="$HARNESS_PARENT"
  effs=""
  for name in "${RIG_WORKERS[@]}"; do
    if effective_worker "$name"; then
      effs+="$name "
    fi
  done
  jobs=0
  if [[ -d "$(repo_root)/.rig/jobs" ]]; then
    jobs="$(command find "$(repo_root)/.rig/jobs" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  echo "parent live=${live:-(none)} preferred=$pref"
  echo "effective: ${effs:-none}"
  echo "jobs: $jobs"
  local jp mp thread last
  jp="$(py_script jobs.py)"
  if [[ -f "$jp" ]]; then
    thread="$(python3 "$jp" thread 2>/dev/null || true)"
    [[ -n "$thread" ]] && echo "thread: $thread"
  fi
  mp="$(py_script memory.py)"
  if [[ -f "$mp" ]]; then
    echo "memory: $(python3 "$mp" count 2>/dev/null || echo 0) facts"
  fi
  last="$(repo_root)/.rig/STATE.md"
  if [[ -f "$last" ]]; then
    echo "state:"
    command grep -E '^- (last_job|worker|status|summary):' "$last" | sed 's/^/  /'
  fi
  if [[ -f "$jp" ]]; then
    python3 "$jp" list
  fi
}

cmd_jobs() {
  python3 "$(py_script jobs.py)" list "$@"
}

cmd_memory() {
  local sub="${1:-show}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$sub" in
    show|count)
      python3 "$(py_script memory.py)" "$sub"
      ;;
    add)
      local fact="$*"
      if [[ -z "$fact" && ! -t 0 ]]; then
        fact="$(cat)"
      fi
      if [[ -z "$fact" ]]; then
        echo "usage: rig memory add \"standing fact\"" >&2
        exit 2
      fi
      python3 "$(py_script memory.py)" add "$fact"
      ;;
    -h|--help|help)
      echo "usage: rig memory [show|add \"standing fact\"]" >&2
      exit 2
      ;;
    *)
      python3 "$(py_script memory.py)" add "$sub $*"
      ;;
  esac
}

cmd_tui() {
  python3 "$(py_script rig_tui.py)" "$@"
}

effective_csv() {
  local name out=""
  for name in "${RIG_WORKERS[@]}"; do
    if effective_worker "$name"; then
      out+="${out:+,}$name"
    fi
  done
  printf '%s\n' "$out"
}

cmd_pick() {
  local role="" case_text="" json=0 arg
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --case)
        case_text="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "usage: rig pick [explore|mini|bulk|implement|hard|review|stay] [--case TEXT] [--json]" >&2
        exit 2
        ;;
      --*)
        echo "rig pick: unknown flag $1" >&2
        exit 2
        ;;
      *)
        role="$1"
        shift
        ;;
    esac
  done
  local args=(pick --live "$(live_parent)" --effective "$(effective_csv)" --role "$role" --case "$case_text")
  [[ "$json" -eq 1 ]] && args+=(--json)
  python3 "$(py_script route.py)" "${args[@]}"
}

cmd_use() {
  local who="${1:-}"
  case "$who" in
    codex|grok|opencode|omp|pi|agy) ;;
    *)
      echo "usage: rig use codex|grok|opencode|omp|pi|agy" >&2
      exit 2
      ;;
  esac
  ensure_harness
  rig_set_toml_key "$(harness_path)" "" "parent" "\"$who\""
  echo "preferred parent = $who"
}

cmd_parent() {
  echo "rig parent is gone. Parent model is chosen in the CLI. Worker models come from rig pick. Never spawn Sol/Astra/Fable as a child." >&2
  exit 2
}

cmd_workers() {
  [[ $# -ge 1 ]] || {
    echo "usage: rig workers grok=on|off claude=on|off codex=on|off cursor=on|off opencode=on|off omp=on|off pi=on|off agy=on|off" >&2
    exit 2
  }
  ensure_harness
  local spec name val bool
  for spec in "$@"; do
    name="${spec%%=*}"
    val="${spec#*=}"
    case "$name" in
      grok|claude|codex|cursor|opencode|omp|pi|agy) ;;
      *)
        echo "rig workers: unknown worker '$name'" >&2
        exit 2
        ;;
    esac
    case "$val" in
      on|true) bool="true" ;;
      off|false) bool="false" ;;
      *)
        echo "rig workers: use on|off (got $val)" >&2
        exit 2
        ;;
    esac
    rig_set_toml_key "$(harness_path)" "workers" "$name" "$bool"
    echo "$name = $bool"
  done
}

cmd_prune() {
  local jobs
  jobs="$(repo_root)/.rig/jobs"
  if [[ ! -d "$jobs" ]]; then
    echo "no jobs dir"
    return 0
  fi
  python3 - "$jobs" <<'PY'
import json
import pathlib
import shutil
import sys
import time

root = pathlib.Path(sys.argv[1])
now = time.time()
removed = 0
logs = 0
for p in list(root.iterdir()):
    if p.is_dir() and now - p.stat().st_mtime > 7 * 86400:
        shutil.rmtree(p)
        removed += 1
dirs = [p for p in root.iterdir() if p.is_dir()]
dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
for p in dirs[20:]:
    shutil.rmtree(p)
    removed += 1
for p in root.iterdir():
    if not p.is_dir():
        continue
    meta, log = p / "meta.json", p / "stdout.log"
    if not log.is_file():
        continue
    status = ""
    if meta.is_file():
        try:
            status = json.loads(meta.read_text()).get("status", "")
        except Exception:
            continue
    if status == "ok":
        log.unlink()
        logs += 1
print(f"prune ok  removed={removed} logs_dropped={logs} kept={len([p for p in root.iterdir() if p.is_dir()])}")
PY
}

is_review_prompt() {
  local p="$1"
  [[ "$p" =~ ^[Rr]eview([[:space:]]|$) ]] || [[ "$p" =~ [[:space:]][Rr]eview[[:space:]] ]]
}

pick_worker() {
  local prompt="$1"
  local live name
  live="$(live_parent)"
  if [[ -z "$live" ]]; then
    live="$(preferred_parent)"
  fi
  if is_review_prompt "$prompt"; then
    for name in claude grok cursor opencode omp pi agy codex; do
      if [[ "$name" == "$live" ]]; then
        continue
      fi
      if effective_worker "$name"; then
        printf '%s\n' "$name"
        return 0
      fi
    done
    printf '%s\n' ""
    return 0
  fi
  if [[ "$live" != "grok" ]] && effective_worker grok; then
    printf '%s\n' "grok"
    return 0
  fi
  for name in claude cursor opencode omp pi agy codex; do
    if [[ "$name" == "$live" ]]; then
      continue
    fi
    if effective_worker "$name"; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  printf '%s\n' ""
}

write_state() {
  local job="$1" worker="$2" status="$3" summary="$4"
  local state
  state="$(repo_root)/.rig/STATE.md"
  mkdir -p "$(dirname "$state")"
  cat > "$state" <<EOF
# STATE

Overwritten each run.

- last_job: $job
- worker: $worker
- status: $status
- summary: $summary
EOF
}

write_job_files() {
  local job_dir="$1"
  mkdir -p "$job_dir"
  local model="${RESULT_MODEL:-}" effort="${RESULT_EFFORT:-}" envout
  if [[ -z "$model" ]]; then
    envout="$(python3 "$(py_script route.py)" env --worker "$3" --role "$4" 2>/dev/null || true)"
    model="$(printf '%s\n' "$envout" | sed -n 's/^RIG_MODEL=//p')"
    effort="$(printf '%s\n' "$envout" | sed -n 's/^RIG_EFFORT=//p')"
  fi
  RESULT_JOB_ID="${2}" \
  RESULT_WORKER="${3}" \
  RESULT_ROLE="${4}" \
  RESULT_STATUS="${5}" \
  RESULT_EXIT="${6}" \
  RESULT_STARTED="${7}" \
  RESULT_ENDED="${8}" \
  RESULT_SUMMARY="${9}" \
  RESULT_KIND="${10:-native}" \
  RESULT_MODEL="$model" \
  RESULT_EFFORT="$effort" \
  RESULT_THREAD="${RESULT_THREAD:-}" \
  python3 - "$job_dir" <<'PY'
import json, os, pathlib, sys
job_dir = pathlib.Path(sys.argv[1])
keep = ("thread", "session_id", "pid", "open", "watch", "kind", "model", "effort")
old = {}
meta_path = job_dir / "meta.json"
if meta_path.is_file():
    try:
        loaded = json.loads(meta_path.read_text())
        if isinstance(loaded, dict):
            old = loaded
    except Exception:
        old = {}
obj = {
    "job_id": os.environ["RESULT_JOB_ID"],
    "worker": os.environ["RESULT_WORKER"],
    "role": os.environ["RESULT_ROLE"],
    "status": os.environ["RESULT_STATUS"],
    "exit_code": int(os.environ["RESULT_EXIT"]),
    "started_at": os.environ["RESULT_STARTED"],
    "ended_at": os.environ["RESULT_ENDED"],
    "summary": os.environ["RESULT_SUMMARY"],
    "files_changed": [],
    "next": "",
    "kind": os.environ.get("RESULT_KIND", "native"),
    "model": os.environ.get("RESULT_MODEL", ""),
    "effort": os.environ.get("RESULT_EFFORT", ""),
}
for key in keep:
    if not obj.get(key) and old.get(key) not in (None, ""):
        obj[key] = old[key]
thread = os.environ.get("RESULT_THREAD", "")
if thread:
    obj["thread"] = thread
for name in ("meta.json", "result.json"):
    path = job_dir / name
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2) + "\n")
    tmp.replace(path)
PY
}

new_job_id() {
  printf '%s-%s\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

parse_job_flags() {
  JOB_WORKER=""
  JOB_ROLE="worker"
  JOB_ROLE_SET=0
  JOB_STATUS="ok"
  JOB_SUMMARY=""
  JOB_ID=""
  JOB_FOLLOW=0
  JOB_LINES=""
  JOB_REASON=""
  JOB_TIMEOUT=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --worker)
        JOB_WORKER="${2:-}"
        shift 2
        ;;
      --role)
        JOB_ROLE="${2:-}"
        JOB_ROLE_SET=1
        shift 2
        ;;
      --status)
        JOB_STATUS="${2:-}"
        shift 2
        ;;
      --summary)
        JOB_SUMMARY="${2:-}"
        shift 2
        ;;
      -f|--follow)
        JOB_FOLLOW=1
        shift
        ;;
      -n|--lines)
        JOB_LINES="${2:-}"
        shift 2
        ;;
      --reason)
        JOB_REASON="${2:-}"
        shift 2
        ;;
      --timeout)
        JOB_TIMEOUT="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "usage: rig job start|finish|record|show|log|allow|deny|wait [--worker NAME] [--role ROLE] [--status ok|fail] [--summary TEXT] [--reason TEXT] [--timeout SECS] [id] [-f] [-n N]" >&2
        exit 2
        ;;
      --*)
        echo "rig job: unknown flag $1" >&2
        exit 2
        ;;
      *)
        if [[ -n "$JOB_ID" ]]; then
          echo "rig job: extra arg $1" >&2
          exit 2
        fi
        JOB_ID="$1"
        shift
        ;;
    esac
  done
}

cmd_job() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    start|finish|record|show|log|allow|deny|wait) ;;
    *)
      echo "usage: rig job start|finish|record|show|log|allow|deny|wait [--worker NAME] [--role ROLE] [--status ok|fail] [--summary TEXT] [--reason TEXT] [--timeout SECS] [id] [-f] [-n N]" >&2
      exit 2
      ;;
  esac
  parse_job_flags "$@"
  local root harness
  root="$(repo_root)"
  harness="$(harness_path)"
  if [[ ! -f "$harness" ]]; then
    echo "rig job: missing $harness — run: rig init" >&2
    exit 1
  fi
  local job_dir_early=""
  if [[ -n "$JOB_ID" ]]; then
    job_dir_early="$(repo_root)/.rig/jobs/$JOB_ID"
  fi
  if [[ -z "$JOB_WORKER" && -f "${job_dir_early}/meta.json" ]]; then
    JOB_WORKER="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("worker",""))' "$job_dir_early/meta.json" 2>/dev/null || true)"
  fi
  if [[ "$JOB_ROLE_SET" -eq 0 && -f "${job_dir_early}/meta.json" && "$sub" == "finish" ]]; then
    local existing_role
    existing_role="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("role",""))' "$job_dir_early/meta.json" 2>/dev/null || true)"
    [[ -n "$existing_role" ]] && JOB_ROLE="$existing_role"
  fi
  if [[ -z "$JOB_WORKER" ]]; then
    JOB_WORKER="$(live_parent)"
    if [[ -z "$JOB_WORKER" ]]; then
      JOB_WORKER="$(preferred_parent)"
    fi
  fi
  case "$JOB_WORKER" in
    grok|codex|claude|cursor|opencode|omp|pi|agy|parent) ;;
    *)
      echo "rig job: worker must be grok|codex|claude|cursor|opencode|omp|pi|agy|parent" >&2
      exit 2
      ;;
  esac
  case "$JOB_STATUS" in
    ok|fail|timeout|running) ;;
    *)
      echo "rig job: status must be ok|fail|timeout|running" >&2
      exit 2
      ;;
  esac

  if [[ "$sub" == "show" ]]; then
    if [[ -n "$JOB_ID" ]]; then
      python3 "$(py_script jobs.py)" show "$JOB_ID"
    else
      python3 "$(py_script jobs.py)" show
    fi
    return 0
  fi
  if [[ "$sub" == "log" ]]; then
    local log_args=()
    [[ "$JOB_FOLLOW" -eq 1 ]] && log_args+=(-f)
    [[ -n "$JOB_LINES" ]] && log_args+=(-n "$JOB_LINES")
    [[ -n "$JOB_ID" ]] && log_args+=("$JOB_ID")
    python3 "$(py_script jobs.py)" log "${log_args[@]}"
    return 0
  fi
  if [[ "$sub" == "allow" || "$sub" == "deny" ]]; then
    local ask_args=("$sub")
    [[ -n "$JOB_ID" ]] && ask_args+=("$JOB_ID")
    [[ -n "$JOB_REASON" ]] && ask_args+=(--reason "$JOB_REASON")
    python3 "$(py_script jobs.py)" "${ask_args[@]}"
    return $?
  fi
  if [[ "$sub" == "wait" ]]; then
    local wait_args=(wait)
    [[ -n "$JOB_ID" ]] && wait_args+=("$JOB_ID")
    [[ -n "$JOB_TIMEOUT" ]] && wait_args+=(--timeout "$JOB_TIMEOUT")
    python3 "$(py_script jobs.py)" "${wait_args[@]}"
    return $?
  fi

  if [[ "$sub" == "start" || "$sub" == "record" ]]; then
    if [[ "$JOB_WORKER" != "parent" ]]; then
      local live flag
      live="$(live_parent)"
      flag="$(worker_flag "$JOB_WORKER")"
      if [[ "$JOB_WORKER" != "$live" && "$flag" != "true" ]]; then
        echo "rig job: worker $JOB_WORKER is off in harness" >&2
        exit 1
      fi
    fi
  fi

  if [[ "$sub" == "finish" && -z "$JOB_ID" ]]; then
    echo "usage: rig job finish <id> [--status ok|fail] [--summary TEXT]" >&2
    exit 2
  fi
  if [[ -z "$JOB_ID" ]]; then
    JOB_ID="$(new_job_id)"
  fi
  if [[ ! "$JOB_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "rig job: invalid job id '$JOB_ID'" >&2
    exit 2
  fi

  local job_dir now
  job_dir="$root/.rig/jobs/$JOB_ID"
  now="$(iso_now)"
  mkdir -p "$job_dir"
  RESULT_THREAD="${RIG_THREAD:-}"
  if [[ -z "$RESULT_THREAD" ]]; then
    RESULT_THREAD="$(python3 "$(py_script jobs.py)" thread --repo "$root" 2>/dev/null || true)"
  fi
  export RESULT_THREAD

  if [[ "$sub" == "start" ]]; then
    write_job_files "$job_dir" "$JOB_ID" "$JOB_WORKER" "$JOB_ROLE" "running" "0" "$now" "" "$JOB_SUMMARY" "native"
    printf '%s\n' "$now" > "$job_dir/started_at"
    write_state "$JOB_ID" "$JOB_WORKER" "running" "$JOB_SUMMARY"
    echo "job $JOB_ID worker=$JOB_WORKER role=$JOB_ROLE status=running" >&2
    printf '%s\n' "$JOB_ID"
    return 0
  fi

  local started="$now"
  if [[ -f "$job_dir/started_at" ]]; then
    started="$(cat "$job_dir/started_at")"
  elif [[ -f "$job_dir/meta.json" ]]; then
    started="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("started_at",""))' "$job_dir/meta.json" 2>/dev/null || true)"
    [[ -n "$started" ]] || started="$now"
  fi
  local exit_code=0
  [[ "$JOB_STATUS" == "ok" ]] || exit_code=1
  [[ "$JOB_STATUS" == "timeout" ]] && exit_code=124
  write_job_files "$job_dir" "$JOB_ID" "$JOB_WORKER" "$JOB_ROLE" "$JOB_STATUS" "$exit_code" "$started" "$now" "$JOB_SUMMARY" "native"
  write_state "$JOB_ID" "$JOB_WORKER" "$JOB_STATUS" "$JOB_SUMMARY"
  if [[ "$JOB_STATUS" == "ok" ]]; then
    rm -f "$job_dir/stdout.log"
  fi
  echo "job $JOB_ID worker=$JOB_WORKER role=$JOB_ROLE status=$JOB_STATUS"
  echo "$job_dir/result.json"
}

cmd_run() {
  local prompt="${*:-}"
  if [[ -z "$prompt" ]]; then
    echo "usage: rig run \"prompt\"" >&2
    exit 2
  fi
  local root harness
  root="$(repo_root)"
  harness="$(harness_path)"
  if [[ ! -f "$harness" ]]; then
    echo "rig run: missing $harness — run: rig init" >&2
    exit 1
  fi
  parse_harness "$harness"
  local job brief wrapper choice worker
  job="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$root/.rig/jobs/$job"
  brief="$root/.rig/jobs/$job/brief.md"
  {
    printf '%s\n\n' "$WORKER_PREAMBLE"
    printf '%s\n' "$prompt"
  } > "$brief"

  choice="$(python3 "$(py_script route.py)" pick --live "$(live_parent)" --effective "$(effective_csv)" --case "$prompt" --json)"
  local spawn model effort kind
  worker="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("worker",""))')"
  spawn="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("spawn",""))')"
  model="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("model",""))')"
  effort="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("effort",""))')"
  kind="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("kind",""))')"

  if [[ "$spawn" == "stay" ]]; then
    echo "parent keeps this (plan / vision / computer-use / chrome-profile). Do it here, or spawn a worker if this CLI cannot."
    echo "$choice"
    write_state "$job" "${worker:-parent}" "ok" "parent keeps this; spawn a worker only if this CLI cannot"
    exit 0
  fi
  if [[ "$spawn" != "run-worker" || -z "$worker" ]]; then
    echo "no effective cross-CLI worker. Use cheaper same-CLI workers. That is success."
    echo "$choice"
    write_state "$job" "none" "ok" "no effective cross-CLI worker; use cheap same-CLI workers"
    exit 0
  fi

  wrapper="$(rig_home)/scripts/run-worker.sh"
  if [[ ! -f "$wrapper" ]]; then
    wrapper="$(rig_source_root)/scripts/run-worker.sh"
  fi
  export RIG_ROLE="${kind:-implement}"
  export RIG_MODEL="$model"
  export RIG_EFFORT="$effort"
  local rc=0
  set +e
  "$wrapper" "$worker" "$job" "$brief"
  rc=$?
  set -e
  local result="$root/.rig/jobs/$job/result.json" status="unknown" summary=""
  if [[ -f "$result" ]] && command -v python3 >/dev/null 2>&1; then
    status="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status",""))' "$result")"
    summary="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("summary",""))' "$result")"
  fi
  write_state "$job" "$worker" "$status" "$summary"
  echo "job $job worker=$worker status=$status"
  echo "result: $result"
  exit "$rc"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    update) cmd_update "$@" ;;
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    status) cmd_status "$@" ;;
    use) cmd_use "$@" ;;
    parent) cmd_parent "$@" ;;
    workers) cmd_workers "$@" ;;
    prune) cmd_prune "$@" ;;
    run) cmd_run "$@" ;;
    jobs) cmd_jobs "$@" ;;
    tui) cmd_tui "$@" ;;
    memory) cmd_memory "$@" ;;
    job) cmd_job "$@" ;;
    pick) cmd_pick "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "rig: unknown command '$cmd'" >&2
      usage
      ;;
  esac
}

main "$@"

#!/usr/bin/env bash
set -euo pipefail

# The pending path runs before sourcing any potentially half-updated runtime.
# Recovery code is the private pre-update controller, outside replaced assets.
_RIG_PENDING_ROOT="${RIG_HOME:-$HOME/.rig}"
if [[ -e "$_RIG_PENDING_ROOT/updates/pending.json" || -L "$_RIG_PENDING_ROOT/updates/pending.json" ]]; then
  case "${1:-}" in
    update)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Pending runtime update: rig update --status, then rig update --recover"
        exit 1
      fi
      exec python3 -E -s -B "$_RIG_PENDING_ROOT/updates/recovery/runtime_update.py" "$@"
      ;;
    help|-h|--help|"")
      echo "Pending runtime update: rig update --status | rig update --recover"
      exit 0
      ;;
    *)
      echo "rig: pending runtime update; use rig update --status or rig update --recover before other commands" >&2
      exit 1
      ;;
  esac
fi

_RIG_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_RIG_DETECT=""
if [[ -f "$_RIG_BIN_DIR/../scripts/detect-binaries.sh" ]]; then
  _RIG_DETECT="$(cd "$_RIG_BIN_DIR/../scripts" && pwd)/detect-binaries.sh"
elif [[ -f "${RIG_HOME:-$HOME/.rig}/scripts/detect-binaries.sh" ]]; then
  _RIG_DETECT="${RIG_HOME:-$HOME/.rig}/scripts/detect-binaries.sh"
else
  echo "rig: cannot find scripts/detect-binaries.sh" >&2
  exit 1
fi
# shellcheck source=../scripts/detect-binaries.sh
source "$_RIG_DETECT"

usage() {
  cat <<'EOF'
usage: rig <command> [args]

  setup [--shell-ui] [--shell bash|zsh] [--rc-file PATH] [--cua-driver|--no-cua-driver] [--browser-skill|--no-browser-skill] [--mimo|--no-mimo]
    Optional desktop/browser components ask once (default No); their shared skills install only after opt-in.
  ui [open|status|enable|disable|stop]
  uninstall [--dry-run] [--repo PATH]
  update                                  guided (TTY); without a TTY prints exact commands, changes nothing
  update --latest [--dry-run] [--yes]     pin official main to one full SHA, preview, apply on consent
  update --revision FULL_COMMIT_SHA [--dry-run]
  update --rollback [--dry-run] | --recover | --status
  update --migrate (--latest|--revision SHA) [--project PATH] [--new-root PATH] [--dry-run] [--yes]
  update --restore-migration DIR [--dry-run] [--yes] [--force]
    Legacy installs: run a checkout's bin/rig (older installed CLIs lack --migrate).
  init [--patch-agents|--no-patch-agents] [--patch-claude]
  doctor [--task coding|research|browser|computer-use] [--parent NAME] [--model MODEL] [--json] [--smoke]
    Task doctor is offline; --smoke checks only a temporary child MCP fixture.
  computer-use [status|setup|on|off|doctor|unlock|serve]
  browser-skill [status|setup|on|off|doctor]
  status
  use codex|grok|opencode|omp|pi|agy
  workers grok=on|off claude=on|off codex=on|off cursor=on|off opencode=on|off omp=on|off pi=on|off agy=on|off devin=on|off mimo=on|off
  prune
  run "prompt"
  jobs [--json] [--thread [ID]]
  tui
  memory [show]
  memory add "standing fact"
  job start [--worker NAME] [--role ROLE] [id]
  job finish <id> [--status ok|fail] [--summary TEXT] [--token-usage-json JSON]
  job record [--worker NAME] [--role ROLE] [--status ok|fail] [--summary TEXT] [id]
    start/record metadata: [--model MODEL] [--effort EFFORT] [--executor-kind parent|native_child]
  job show [id]
  job ui-evidence <id> --file PACK.json [--credentials-path PATH]
  job log [id] [-f] [-n N]
  job allow [id]
  job deny [id] [--reason TEXT]
  job cancel [id]
  job wait [id ...] [--timeout SECS]
  job message <id> --text TEXT
  job recover-parent-write <id> --confirmed-stopped --rationale TEXT
  job break-glass-close <id> --credentials-path PATH --confirmed-stopped --rationale TEXT
  queue add [--priority N] [--worker NAME] "text"
  queue list
  queue cancel <id>
  queue claim [--files a,b] [id]   # id required if more than one pending
  queue unclaim <id>
  queue spawned <id> --job <job-id> [--files a,b]
  timeline --workflow ID | --job ID [--attempt ID] [--limit 1..200] [--json]
  workflows [--json]
  context preview|build|show|validate --file PATH
  recovery guide --job ID | --workflow ID [--json]
  task prepare --file INPUT.json [--json]
  workflow create [--file PATH] [--json]    # JSON spec from --file or stdin
  workflow recipe list|show|preview [NAME] [--file PARAMS.json] [--spec-only] [--json]
  workflow show|advance|wait|extend|resolve|approve|cancel|report <id>
  pick [explore|mini|bulk|implement|hard|review|verify|stay] [--case TEXT] [--exclude NAME] [--json]
  session [--role KIND] [--case TEXT] [--exclude NAME] [--compact] [--terminal-limit 0..100] [--json]
    pick/session metadata: [--parent-model MODEL] [--parent-effort EFFORT] (actual session only)
    domain: [--task-domain DOMAIN] [--research-source REPO_FILE] (repeatable)
    assessment: [--complexity low|medium|high] [--risk ...] [--uncertainty ...] [--assessment-reason TEXT]
    [--explain] [--policy-mode smart|legacy]
  routing report [--days N] [--json]
  routing engine local|jev
  routing objective quality|balanced|speed|cost
  provider jev setup|status|remove
  billing import [--file PATH] [--scope NAME] [--dry-run] [--json]
  billing sync openai|anthropic [--file PATH] [--scope NAME] [--dry-run] [--validate] [--network] [--json]
  billing report [--scope NAME] [--json]
  benchmark create [--file PATH] [--json]
  benchmark outcome --id ID --job JOB --task TASK --arm rig|baseline [--json]
  benchmark report --id ID [--json]
  diagram PATH [--ascii] [--popup] [--output PATH]

Stay in Codex, Grok, OpenCode, OMP, Pi, or agy. They can invoke Claude, Cursor, OpenCode, OMP, Pi, agy, Devin, or each other. Devin is child-only; a live Devin session turns the devin child off.
EOF
  exit 2
}

rig_source_root() {
  if [[ -n "${RIG_SRC:-}" && -f "$RIG_SRC/bin/rig" ]]; then
    printf '%s\n' "$RIG_SRC"
    return 0
  fi
  local root
  root="$(cd "$_RIG_BIN_DIR/.." && pwd)"
  if [[ -f "$root/skills/delegate-harness/SKILL.md" ]]; then
    printf '%s\n' "$root"
    return 0
  fi
  printf '%s\n' "$(rig_home)"
}

install_file() {
  local srcf="$1" destf="$2"
  local tmp
  tmp="$(mktemp "${destf}.XXXXXX")"
  cp "$srcf" "$tmp"
  mv "$tmp" "$destf"
}

copy_dir_files() {
  local srcdir="$1" destdir="$2"
  local f
  [[ -d "$srcdir" ]] || return 0
  mkdir -p "$destdir"
  for f in "$srcdir/"*; do
    [[ -f "$f" ]] || continue
    install_file "$f" "$destdir/$(basename "$f")"
  done
}

copy_tree() {
  local srcdir="$1" destdir="$2"
  local f base
  [[ -d "$srcdir" ]] || return 0
  mkdir -p "$destdir"
  for f in "$srcdir"/* "$srcdir"/.[!.]* "$srcdir"/..?*; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f")"
    if [[ -d "$f" ]]; then
      copy_tree "$f" "$destdir/$base"
    elif [[ -f "$f" ]]; then
      install_file "$f" "$destdir/$base"
    fi
  done
}

copy_rig_tree() {
  local src="$1" dest="$2"
  mkdir -p "$dest"/{bin,scripts,skills,adapters/codex/agents,adapters/codex/prompts,adapters/codex/plugin,adapters/grok,adapters/claude,adapters/cursor,adapters/opencode/commands,adapters/opencode/plugin,adapters/opencode/tui,adapters/omp/extensions,adapters/pi/extensions,adapters/agy,templates}
  if [[ "$(cd "$src" && pwd)" != "$(cd "$dest" && pwd)" ]]; then
    # mv onto dest so a running bin/rig keeps its old inode
    install_file "$src/bin/rig" "$dest/bin/rig"
    local f skill nested
    for f in "$src/scripts/"*; do
      [[ -f "$f" ]] || continue
      install_file "$f" "$dest/scripts/$(basename "$f")"
    done
    # The MCP facade imports this package in installed runtimes too.
    copy_dir_files "$src/scripts/mcp_tools" "$dest/scripts/mcp_tools"
    for skill in "$src/skills/"*; do
      [[ -d "$skill" ]] || continue
      mkdir -p "$dest/skills/$(basename "$skill")"
      for f in "$skill/"*; do
        if [[ -f "$f" ]]; then
          install_file "$f" "$dest/skills/$(basename "$skill")/$(basename "$f")"
        elif [[ -d "$f" ]]; then
          mkdir -p "$dest/skills/$(basename "$skill")/$(basename "$f")"
          for nested in "$f/"*; do
            [[ -f "$nested" ]] || continue
            install_file "$nested" "$dest/skills/$(basename "$skill")/$(basename "$f")/$(basename "$nested")"
          done
        fi
      done
    done
    for f in "$src/adapters/codex/agents/"*.toml; do
      install_file "$f" "$dest/adapters/codex/agents/$(basename "$f")"
    done
    if [[ -d "$src/adapters/codex/prompts" ]]; then
      mkdir -p "$dest/adapters/codex/prompts"
      for f in "$src/adapters/codex/prompts/"*; do
        [[ -f "$f" ]] || continue
        install_file "$f" "$dest/adapters/codex/prompts/$(basename "$f")"
      done
    fi
    if [[ -d "$src/adapters/opencode/commands" ]]; then
      mkdir -p "$dest/adapters/opencode/commands"
      for f in "$src/adapters/opencode/commands/"*; do
        [[ -f "$f" ]] || continue
        install_file "$f" "$dest/adapters/opencode/commands/$(basename "$f")"
      done
    fi
    copy_dir_files "$src/adapters/opencode/plugin" "$dest/adapters/opencode/plugin"
    copy_dir_files "$src/adapters/opencode/tui" "$dest/adapters/opencode/tui"
    copy_dir_files "$src/adapters/omp/extensions" "$dest/adapters/omp/extensions"
    copy_dir_files "$src/adapters/pi/extensions" "$dest/adapters/pi/extensions"
    copy_tree "$src/adapters/codex/plugin" "$dest/adapters/codex/plugin"
    if [[ -f "$src/adapters/codex/marketplace.json" ]]; then
      install_file "$src/adapters/codex/marketplace.json" "$dest/adapters/codex/marketplace.json"
    fi
    install_file "$src/adapters/grok/config.toml.snippet" "$dest/adapters/grok/config.toml.snippet"
    install_file "$src/adapters/claude/CLAUDE.worker.md" "$dest/adapters/claude/CLAUDE.worker.md"
    if [[ -f "$src/adapters/cursor/CURSOR.worker.md" ]]; then
      install_file "$src/adapters/cursor/CURSOR.worker.md" "$dest/adapters/cursor/CURSOR.worker.md"
    fi
    if [[ -f "$src/adapters/opencode/OPENCODE.worker.md" ]]; then
      install_file "$src/adapters/opencode/OPENCODE.worker.md" "$dest/adapters/opencode/OPENCODE.worker.md"
    fi
    if [[ -f "$src/adapters/omp/OMP.worker.md" ]]; then
      install_file "$src/adapters/omp/OMP.worker.md" "$dest/adapters/omp/OMP.worker.md"
    fi
    if [[ -f "$src/adapters/pi/PI.worker.md" ]]; then
      install_file "$src/adapters/pi/PI.worker.md" "$dest/adapters/pi/PI.worker.md"
    fi
    if [[ -f "$src/adapters/agy/AGY.worker.md" ]]; then
      install_file "$src/adapters/agy/AGY.worker.md" "$dest/adapters/agy/AGY.worker.md"
    fi
    for f in "$src/templates/"*; do
      [[ -f "$f" ]] || continue
      install_file "$f" "$dest/templates/$(basename "$f")"
    done
    copy_dir_files "$src/templates/workflows" "$dest/templates/workflows"
  fi
  chmod +x "$dest/bin/rig" "$dest/scripts/"*.sh "$dest/scripts/"*.py 2>/dev/null || true
  if git -C "$src" rev-parse --short HEAD >/dev/null 2>&1; then
    printf 'v1 %s\n' "$(git -C "$src" rev-parse --short HEAD)" > "$dest/VERSION"
  else
    printf 'v1\n' > "$dest/VERSION"
  fi
}

py_script() {
  local name="$1" p
  p="$(rig_home)/scripts/$name"
  if [[ -f "$p" ]]; then
    printf '%s\n' "$p"
    return 0
  fi
  printf '%s\n' "$(rig_source_root)/scripts/$name"
}

ensure_skill_link() {
  local dest="$1" src="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    ln -sfn "$src" "$dest"
    printf 'linked %s\n' "$dest"
  elif [[ -e "$dest" ]]; then
    printf 'skip %s (exists, not a symlink)\n' "$dest"
  else
    ln -sfn "$src" "$dest"
    printf 'linked %s\n' "$dest"
  fi
}

# Bash 3.2 can apply errexit inside guarded `command` calls. Keep their
# failure inside a subshell so the surrounding condition handles it normally.
maybe_copy_codex_agent() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -e "$dest" ]]; then
    if (command grep -q "You are a Rig" "$dest" 2>/dev/null); then
      install_file "$src" "$dest"
      printf 'refreshed %s\n' "$dest"
      return 0
    fi
    printf 'skip %s (exists, not a Rig agent)\n' "$dest"
    return 0
  fi
  cp "$src" "$dest"
  printf 'wrote %s\n' "$dest"
}

maybe_copy_queue_adapter() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  if [[ -e "$dest" ]]; then
    if (command grep -q "Park a Rig" "$dest" 2>/dev/null) || (command grep -q "rig queue" "$dest" 2>/dev/null); then
      install_file "$src" "$dest"
      printf 'refreshed %s\n' "$dest"
      return 0
    fi
    printf 'skip %s (exists, not a Rig queue adapter)\n' "$dest"
    return 0
  fi
  cp "$src" "$dest"
  printf 'wrote %s\n' "$dest"
}

cmd_setup() {
  local shell_ui=0 shell_args=() cua_flags=() bsk_flags=() mimo_flag=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --shell-ui) shell_ui=1; shift ;;
      --shell|--rc-file) [[ $# -ge 2 ]] || return 2; shell_args+=("$1" "$2"); shift 2 ;;
      --cua-driver|--no-cua-driver) cua_flags+=("$1"); shift ;;
      --browser-skill|--no-browser-skill) bsk_flags+=("$1"); shift ;;
      --mimo|--no-mimo) mimo_flag="$1"; shift ;;
      *) echo "rig setup: unknown flag $1" >&2; return 2 ;;
    esac
  done
  # Bash 3.2 treats empty arrays as unset under nounset.
  if [[ " ${cua_flags[*]-} " == *" --cua-driver "* && " ${cua_flags[*]-} " == *" --no-cua-driver "* ]] ||
     [[ " ${bsk_flags[*]-} " == *" --browser-skill "* && " ${bsk_flags[*]-} " == *" --no-browser-skill "* ]]; then
    echo "rig setup: choose either the install or skip flag for each optional component" >&2
    return 2
  fi
  local src dest
  src="$(rig_source_root)"
  dest="$(rig_home)"
  if [[ ! -f "$src/bin/rig" || ! -f "$src/skills/delegate-harness/SKILL.md" ]]; then
    echo "rig setup: source tree not found at $src" >&2
    echo "set RIG_SRC to the Rig clone and retry" >&2
    exit 1
  fi
  copy_rig_tree "$src" "$dest"
  # All entry points (including install.sh/update) resolve consent exactly once,
  # before exposing optional skills in the host's discovery directories.
  local optional_py
  optional_py="$(py_script install-cua-driver.py)"
  if [[ -f "$optional_py" ]]; then
    python3 "$optional_py" ${cua_flags[@]+"${cua_flags[@]}"} || true
  else
    echo "cua-driver setup: installer missing; skip. Enable later: rig computer-use setup"
  fi
  optional_py="$(py_script install-browser-skill.py)"
  if [[ -f "$optional_py" ]]; then
    python3 "$optional_py" ${bsk_flags[@]+"${bsk_flags[@]}"} || true
  else
    echo "browser-skill setup: installer missing; skip. Enable later: rig browser-skill setup"
  fi
  local optional_skills=false
  optional_skills="$(python3 "$(py_script optional_skills.py)" "$dest")"
  mkdir -p "$HOME/.agents/skills" "$HOME/.grok/skills" "$HOME/.codex/agents" "$HOME/.codex/skills" \
    "$HOME/.codex/prompts" "$HOME/.config/opencode/skill" "$HOME/.config/opencode/commands" \
    "$HOME/.omp/agent/skills" "$HOME/.pi/agent/skills" \
    "$HOME/.gemini/antigravity-cli/skills"
  local skill
  for skill in delegate-harness rig-jobs rig-queue computer-use style-guide computer-test; do
    if [[ "$skill" == "computer-use" || "$skill" == "computer-test" ]] && [[ "$optional_skills" != "true" ]]; then
      continue
    fi
    ensure_skill_link "$HOME/.agents/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.grok/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.codex/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.config/opencode/skill/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.omp/agent/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.pi/agent/skills/$skill" "$dest/skills/$skill"
    ensure_skill_link "$HOME/.gemini/antigravity-cli/skills/$skill" "$dest/skills/$skill"
  done

  local name
  for name in explorer worker bulk reviewer; do
    maybe_copy_codex_agent \
      "$dest/adapters/codex/agents/${name}.toml" \
      "$HOME/.codex/agents/${name}.toml"
  done
  local qsrc
  qsrc="$dest/adapters/codex/prompts/queue.md"
  [[ -f "$qsrc" ]] || qsrc="$(rig_source_root)/adapters/codex/prompts/queue.md"
  if [[ -f "$qsrc" ]]; then
    maybe_copy_queue_adapter "$qsrc" "$HOME/.codex/prompts/queue.md"
  fi
  qsrc="$dest/adapters/opencode/commands/queue.md"
  [[ -f "$qsrc" ]] || qsrc="$(rig_source_root)/adapters/opencode/commands/queue.md"
  if [[ -f "$qsrc" ]]; then
    maybe_copy_queue_adapter "$qsrc" "$HOME/.config/opencode/commands/queue.md"
  fi

  local hook_py hook_dest py_bin
  hook_py="$dest/scripts/queue_submit_hook.py"
  [[ -f "$hook_py" ]] || hook_py="$(rig_source_root)/scripts/queue_submit_hook.py"
  if [[ -f "$hook_py" ]]; then
    mkdir -p "$HOME/.grok/hooks"
    hook_dest="$HOME/.grok/hooks/rig-queue-submit.json"
    if [[ -e "$hook_dest" ]] && ! (command grep -q "queue_submit_hook" "$hook_dest" 2>/dev/null); then
      printf 'skip %s (exists, not a Rig queue hook)\n' "$hook_dest"
    else
      py_bin="$(command -v python3 || true)"
      python3 - "$hook_dest" "${py_bin:-python3}" "$hook_py" <<'PY'
import json, pathlib, sys
dest, py, script = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
obj = {
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": f"{py} {script}",
                        "timeout": 10,
                    }
                ]
            }
        ]
    }
}
dest.parent.mkdir(parents=True, exist_ok=True)
tmp = dest.with_name(dest.name + ".tmp")
tmp.write_text(json.dumps(obj, indent=2) + "\n")
tmp.replace(dest)
print(f"wrote {dest}")
PY
    fi
  fi

  local codex_cfg="$HOME/.codex/config.toml"
  if [[ -f "$codex_cfg" ]]; then
    if ! rig_has_top_key "$codex_cfg" "model"; then
      rig_set_toml_key "$codex_cfg" "" "model" '"gpt-5.6-sol"'
      echo "set ~/.codex/config.toml model = \"gpt-5.6-sol\" (was missing)"
    fi
    if ! rig_has_section_key "$codex_cfg" "agents" "default_subagent_model"; then
      rig_set_toml_key "$codex_cfg" "agents" "default_subagent_model" '"gpt-5.6-terra"'
      echo "set ~/.codex/config.toml [agents] default_subagent_model = \"gpt-5.6-terra\" (was missing)"
    fi
    sandbox_fix="$(rig_ensure_codex_child_sandbox "$codex_cfg")"
    if [[ "$sandbox_fix" != "keep" ]]; then
      echo "set ~/.codex/config.toml [sandbox_workspace_write] ($sandbox_fix) so Grok/Claude/Cursor/OpenCode/OMP/Pi/agy children can write sessions"
    fi
  fi

  local grok_cfg="$HOME/.grok/config.toml"
  if [[ -f "$grok_cfg" ]]; then
    if ! rig_has_section_key "$grok_cfg" "subagents.models" "explore"; then
      rig_set_toml_key "$grok_cfg" "subagents.models" "explore" '"grok-4.5"'
      echo "set ~/.grok/config.toml [subagents.models] explore = \"grok-4.5\" (was missing)"
    fi
  fi

  local ui_py
  ui_py="$(py_script install-ui.py)"
  if [[ -f "$ui_py" ]]; then
    python3 "$ui_py" "$dest"
  fi
  local mimo_py
  mimo_py="$(py_script mimo_setup.py)"
  if [[ -f "$mimo_py" ]]; then
    if [[ -n "$mimo_flag" ]]; then
      python3 "$mimo_py" "$mimo_flag" --repo "$(repo_root)" --rig-bin "$dest/bin/rig" || true
    else
      python3 "$mimo_py" --repo "$(repo_root)" --rig-bin "$dest/bin/rig" || true
    fi
  else
    echo "MiMo setup: helper missing; retry after rig update: rig setup --mimo"
  fi

  mkdir -p "$HOME/.local/bin"
  if [[ ! -e "$HOME/.local/bin/rig" || -L "$HOME/.local/bin/rig" ]]; then
    ln -sfn "$dest/bin/rig" "$HOME/.local/bin/rig"
  fi
  if [[ "$shell_ui" -eq 1 ]]; then
    python3 "$dest/scripts/ui_shell.py" enable ${shell_args[@]+"${shell_args[@]}"}
  fi
  echo "setup ok  RIG_HOME=$dest"
  echo "watch: rig tui   |   rig jobs   |   /rig /queue in Grok, Codex, OpenCode, OMP, Pi, or agy"
  echo "next: in a repo, run: rig init && rig doctor"
}

cmd_update() {
  if [[ -n "${RIG_LIVE:-}" || -n "${RIG_JOB_ID:-}" || -n "${RIG_JOB_DIR:-}" ]]; then
    echo "rig update: refuse inside a worker" >&2
    exit 1
  fi
  # Guided flags use the helper beside this CLI, so a checkout's bin/rig can
  # bootstrap a legacy RIG_HOME whose installed scripts predate them.
  local arg guided=0 assistant="$_RIG_BIN_DIR/../scripts/update_assistant.py"
  [[ $# -gt 0 ]] || guided=1
  for arg in "$@"; do
    case "$arg" in
      --latest|--migrate|--yes|--project|--project=*|--new-root|--new-root=*|--restore-migration|--restore-migration=*) guided=1 ;;
    esac
  done
  if [[ "$guided" -eq 1 ]]; then
    if [[ ! -f "$assistant" ]]; then
      echo "rig update: guided helper missing beside this CLI; use rig update --revision FULL_COMMIT_SHA" >&2
      exit 1
    fi
    PYTHONDONTWRITEBYTECODE=1 python3 "$assistant" "$@"
    return
  fi
  PYTHONDONTWRITEBYTECODE=1 python3 "$(py_script runtime_update.py)" "$@"
}

ensure_harness() {
  local root templates harness
  root="$(repo_root)"
  templates="$(rig_home)/templates"
  if [[ ! -d "$templates" ]]; then
    templates="$(rig_source_root)/templates"
  fi
  mkdir -p "$root/.rig/jobs"
  harness="$root/.rig/harness.toml"
  if [[ ! -f "$harness" ]]; then
    if [[ ! -f "$templates/harness.toml" ]]; then
      echo "rig: templates not found; run: rig setup" >&2
      exit 1
    fi
    cp "$templates/harness.toml" "$harness"
  fi
}

project_state() {
  local harness="$(harness_path)"
  if [[ ! -f "$harness" ]]; then printf '%s\n' uninitialized; return; fi
  python3 "$(py_script harness.py)" >/dev/null 2>&1 || true
  local value
  value="$(awk 'BEGIN{s=""} /^\[project\]/{s="project";next} /^\[/{s=""} s=="project" && $0 ~ /^[[:space:]]*enabled[[:space:]]*=/ {sub(/^[^=]*=/,""); sub(/[[:space:]]*#.*/,""); gsub(/^[[:space:]]+|[[:space:]]+$/,""); print; exit}' "$harness")"
  case "$value" in ""|true) printf '%s\n' enabled ;; false) printf '%s\n' disabled ;; *) printf '%s\n' disabled ;; esac
}

project_guard() {
  local state="$(project_state)"
  if [[ "$state" == "uninitialized" ]]; then echo "Rig is uninitialized for this project; run rig init" >&2; return 1; fi
  if [[ "$state" != "enabled" ]]; then echo "Rig is disabled for this project; run rig on" >&2; return 1; fi
}

cmd_project_toggle() {
  local want="$1" root harness agents state
  root="$(repo_root)"; harness="$root/.rig/harness.toml"; agents="$root/AGENTS.md"
  [[ -f "$harness" ]] || { echo "Rig is uninitialized for this project; run rig init" >&2; return 1; }
  state="$(project_state)"
  if [[ "$want" == off && "$state" == disabled ]]; then echo "Rig is already disabled for this project. Start a new parent thread."; return; fi
  if [[ "$want" == on && "$state" == enabled ]]; then echo "Rig is already enabled for this project. Start a new parent thread."; return; fi
  if [[ "$want" == off ]]; then
    if python3 "$(py_script admission.py)" list --repo "$root" 2>/dev/null | grep -Eq '"(stage|status)": "(reserved|running|verifying|reviewing|unconfirmed|cancel)' ; then
      echo "rig off: active ownership blocks disabling" >&2; return 1
    fi
    python3 - "$harness" <<'PY'
import os,sys,tempfile
p=sys.argv[1]; s=open(p).read();
if '[project]' not in s: s='[project]\nenabled = false\n\n'+s
elif 'enabled' in s[s.index('[project]'):s.find('\n[',s.index('[project]')) if s.find('\n[',s.index('[project]'))>=0 else len(s)]:
 a=s.index('[project]'); b=s.find('\n[',a+1); b=len(s) if b<0 else b; part=s[a:b]; import re; s=s[:a]+re.sub(r'(?m)^\s*enabled\s*=.*$', 'enabled = false', part)+s[b:]
else: s=s.replace('[project]','[project]\nenabled = false',1)
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(p)); os.write(fd,s.encode()); os.close(fd); os.replace(tmp,p)
PY
    if [[ -f "$agents" ]]; then python3 - "$agents" <<'PY'
import os,re,sys,tempfile
p=sys.argv[1]; s=open(p).read(); s=re.sub(r'<!-- rig:start -->.*?<!-- rig:end -->\n?', '', s, count=1, flags=re.S)
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(p)); os.write(fd,s.encode()); os.close(fd); os.replace(tmp,p)
PY
    fi
    echo "Rig disabled for this project. Start a new parent thread."; return
  fi
  cmd_init --patch-agents
  python3 - "$harness" <<'PY'
import os,re,sys,tempfile
p=sys.argv[1]; s=open(p).read();
if '[project]' not in s: s='[project]\nenabled = true\n\n'+s
else:
 a=s.index('[project]'); b=s.find('\n[',a+1); b=len(s) if b<0 else b; part=s[a:b]; s=s[:a]+re.sub(r'(?m)^\s*enabled\s*=.*$', 'enabled = true', part)+s[b:]
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(p)); os.write(fd,s.encode()); os.close(fd); os.replace(tmp,p)
PY
  rig_set_toml_key "$harness" "project" "enabled" "true"
  # The first init intentionally preserves a disabled project's missing block.
  # Re-run after committing enabled=true so the canonical block is restored.
  cmd_init --patch-agents
  echo "Rig enabled for this project. Start a new parent thread."
}

cmd_init() {
  local patch_agents=1 patch_claude=0 arg
  for arg in "$@"; do
    case "$arg" in
      --patch-agents) patch_agents=1 ;;
      --no-patch-agents) patch_agents=0 ;;
      --patch-claude) patch_claude=1 ;;
      *)
        echo "rig init: unknown flag $arg" >&2
        usage
        ;;
    esac
  done

  local root templates
  root="$(repo_root)"
  templates="$(rig_home)/templates"
  if [[ ! -f "$templates/harness.toml" ]]; then
    templates="$(rig_source_root)/templates"
  fi
  if [[ ! -f "$templates/harness.toml" ]]; then
    echo "rig init: templates not found; run: rig setup" >&2
    exit 1
  fi

  mkdir -p "$root/.rig/jobs"
  local f harness harness_new=0
  harness="$root/.rig/harness.toml"
  for f in harness.toml MEMORY.md STATE.md; do
    if [[ -f "$root/.rig/$f" ]]; then
      printf 'keep %s\n' "$root/.rig/$f"
    else
      cp "$templates/$f" "$root/.rig/$f"
      printf 'wrote %s\n' "$root/.rig/$f"
      [[ "$f" == "harness.toml" ]] && harness_new=1
    fi
  done
  if command -v python3 >/dev/null 2>&1; then
    if [[ "$harness_new" -eq 1 ]]; then
      local name flag
      for name in "${RIG_WORKERS[@]}"; do
        [[ "$name" == "codex" ]] && continue
        if [[ "$name" == "mimo" ]]; then
          # MiMo is explicitly opt-in, even when the CLI is already installed.
          flag=false
        elif [[ -n "$(find_worker_bin "$name")" ]]; then
          flag=true
        else
          flag=false
        fi
        rig_set_toml_key "$harness" "workers" "$name" "$flag"
      done
      echo "workers from PATH: grok=$(worker_flag grok) claude=$(worker_flag claude) cursor=$(worker_flag cursor) opencode=$(worker_flag opencode) omp=$(worker_flag omp) pi=$(worker_flag pi) agy=$(worker_flag agy) devin=$(worker_flag devin) mimo=$(worker_flag mimo)"
    elif [[ -f "$harness" ]]; then
      local name
      for name in "${RIG_WORKERS[@]}"; do
        # Older harnesses treat an absent Devin flag as off; keep them byte-for-byte
        # stable until the user explicitly enables this opt-in worker.
        [[ "$name" == "devin" || "$name" == "mimo" ]] && continue
        if ! rig_has_section_key "$harness" "workers" "$name"; then
          rig_set_toml_key "$harness" "workers" "$name" "false"
          echo "appended $name = false (existing harness; run: rig workers $name=on)"
        fi
      done
    fi
    if [[ -f "$harness" ]] && ! rig_has_section_key "$harness" "queue" "max_running"; then
      rig_set_toml_key "$harness" "queue" "max_running" "3"
      echo "appended [queue] max_running = 3"
    fi
    if [[ -f "$harness" ]] && ! rig_has_section_key "$harness" "computer-use" "enabled"; then
      rig_set_toml_key "$harness" "computer-use" "enabled" "false"
      echo "appended [computer-use] enabled = false"
    fi
    if [[ -f "$harness" ]] && ! rig_has_section_key "$harness" "browser-skill" "enabled"; then
      rig_set_toml_key "$harness" "browser-skill" "enabled" "false"
      echo "appended [browser-skill] enabled = false"
    fi
  else
    echo "rig init: no python3; left template worker flags. later: rig workers NAME=on"
  fi

  # Codex loads repo skills from .agents/skills. Refresh core and opted-in skills.
  # An existing directory alone is not consent (older installs copied all skills).
  local optional_skills=false
  if command -v python3 >/dev/null 2>&1; then
    optional_skills="$(python3 "$(py_script optional_skills.py)" "$(rig_home)")"
  fi
  local skills_root skill_dir skill_name dest_skill
  skills_root="$(rig_home)/skills"
  [[ -d "$skills_root" ]] || skills_root="$(rig_source_root)/skills"
  if [[ -d "$skills_root" ]]; then
    for skill_dir in "$skills_root/"*/; do
      [[ -d "$skill_dir" ]] || continue
      skill_name="${skill_dir%/}"
      skill_name="${skill_name##*/}"
      if [[ "$skill_name" == "computer-use" || "$skill_name" == "computer-test" ]] && [[ "$optional_skills" != "true" ]]; then
        continue
      fi
      dest_skill="$root/.agents/skills/${skill_name}"
      mkdir -p "$dest_skill"
      cp -R "$skill_dir/." "$dest_skill/"
      printf 'wrote %s\n' "$dest_skill"
    done
  fi

  local gi="$root/.gitignore" frag_file frag last
  frag_file="$(rig_home)/templates/gitignore-fragment"
  if [[ ! -f "$frag_file" ]]; then
    frag_file="$(rig_source_root)/templates/gitignore-fragment"
  fi
  if [[ -f "$frag_file" ]]; then
    while IFS= read -r frag || [[ -n "$frag" ]]; do
      [[ -n "$frag" ]] || continue
      if [[ -f "$gi" ]] && (command grep -qxF "$frag" "$gi" 2>/dev/null); then
        printf 'keep %s (%s)\n' "$gi" "$frag"
      else
        if [[ -s "$gi" ]]; then
          last="$(tail -c 1 "$gi" 2>/dev/null || true)"
          if [[ "$last" != $'\n' ]]; then
            printf '\n' >> "$gi"
          fi
        fi
        printf '%s\n' "$frag" >> "$gi"
        printf 'appended %s to %s\n' "$frag" "$gi"
      fi
    done < "$frag_file"
  fi

  if [[ "$patch_agents" -eq 1 && "$(project_state)" != "disabled" ]]; then
    local agents="$root/AGENTS.md"
    local block action protocol_template
    protocol_template="$templates/agents-protocol.md"
    if [[ ! -f "$protocol_template" ]]; then
      echo "rig init: generated protocol template missing; update Rig before init" >&2
      return 1
    fi
    block="$(cat "$protocol_template")"
    if ! action="$(rig_upsert_marked_block "$agents" "<!-- rig:start -->" "<!-- rig:end -->" "$block")"; then
      echo "rig init: cannot update managed AGENTS block; existing instructions left unchanged" >&2
      return 1
    fi
    echo "$action $agents"
  elif [[ "$patch_agents" -eq 1 ]]; then
    echo "keep $root/AGENTS.md (Rig project disabled)"
  fi

  if [[ "$patch_claude" -eq 1 ]]; then
    local claude="$root/CLAUDE.md"
    local stub
    stub="$(rig_home)/adapters/claude/CLAUDE.worker.md"
    if [[ ! -f "$stub" ]]; then
      stub="$(rig_source_root)/adapters/claude/CLAUDE.worker.md"
    fi
    if [[ -f "$claude" ]]; then
      echo "keep $claude (exists)"
    else
      cp "$stub" "$claude"
      echo "wrote $claude"
    fi
  fi

  echo "init ok  $root/.rig"
}

worker_reason() {
  local name="$1"
  local flag bin live mcp
  flag="$(worker_flag "$name")"
  bin="$(find_worker_bin "$name")"
  live="$(live_parent)"
  if [[ "$flag" != "true" ]]; then
    printf '%s\n' "disabled; enable with: rig workers $name=on"
  elif [[ -z "$bin" ]]; then
    if [[ "$name" == "mimo" ]]; then
      printf '%s\n' "CLI missing; install with: rig setup --mimo"
    else
      printf '%s\n' "CLI missing; install the $name CLI"
    fi
  elif [[ "$name" == "$live" ]]; then
    printf '%s\n' "is the live parent; choose a different child CLI"
  else
    mcp="$(worker_mcp_reason "$name" 2>/dev/null || true)"
    printf '%s\n' "$mcp"
  fi
}

# Fail open: empty stdout if git/network/timeout.
doctor_remote_main_sha() {
  local url="$1"
  python3 - "$url" <<'PY' 2>/dev/null
import os, subprocess, sys

url = sys.argv[1]
env = os.environ.copy()
env["GIT_TERMINAL_PROMPT"] = "0"
try:
    proc = subprocess.run(
        ["git", "ls-remote", url, "refs/heads/main"],
        capture_output=True,
        text=True,
        timeout=5,
        env=env,
    )
except Exception:
    raise SystemExit(1)
if proc.returncode != 0 or not proc.stdout.strip():
    raise SystemExit(1)
print(proc.stdout.split()[0])
PY
}

doctor_print_update() {
  local ver="${1:-}" local_sha remote
  [[ -n "${RIG_SKIP_UPDATE_CHECK:-}" ]] && return 0
  local_sha="$(awk '{print $2}' <<<"$ver")"
  [[ -n "$local_sha" ]] || return 0
  remote="$(doctor_remote_main_sha "${RIG_REPO_URL:-https://github.com/Brasth/Rig.git}")" || return 0
  [[ -n "$remote" ]] || return 0
  if [[ "$remote" == "$local_sha"* ]]; then
    echo "  update:   current"
  else
    echo "  update:   behind main — review: rig update --revision $remote --dry-run"
  fi
}

cmd_doctor() {
  if [[ "$#" -gt 0 ]]; then
    PYTHONDONTWRITEBYTECODE=1 python3 "$(py_script doctor.py)" --repo "$(repo_root)" "$@"
    return $?
  fi
  local dest root harness live pref runw ver
  dest="$(rig_home)"
  root="$(repo_root)"
  harness="$(harness_path)"
  live="$(live_parent)"
  parse_harness "$harness"
  pref="$HARNESS_PARENT"
  runw="$dest/scripts/run-worker.sh"
  if [[ ! -f "$runw" ]]; then
    runw="$(rig_source_root)/scripts/run-worker.sh"
  fi

  echo "Rig doctor"
  echo "  RIG_HOME: $dest"
  echo "  repo:     $root"
  echo "  project:  $(project_state)"
  if [[ -f "$harness" ]]; then
    echo "  harness:  $harness"
  else
    echo "  harness:  $harness (missing — run: rig init)"
  fi
  if [[ -f "$dest/VERSION" ]]; then
    ver="$(tr -d '\r\n' < "$dest/VERSION")"
  else
    ver=""
  fi
  if [[ -n "$ver" ]]; then
    echo "  version:  $ver"
  else
    echo "  version:  (unknown — run: rig update --status)"
  fi
  doctor_print_update "$ver"
  echo
  echo "Parent"
  echo "  live:      ${live:-(none)}"
  echo "  preferred: ${pref:-(none)}"
  echo
  echo "Workers"
  local name flag bin reason eff
  for name in "${RIG_WORKERS[@]}"; do
    flag="$(worker_flag "$name")"
    bin="$(find_worker_bin "$name")"
    reason="$(worker_reason "$name")"
    if [[ -z "$reason" ]]; then
      eff="on"
    else
      eff="off"
    fi
    printf '  %-8s flag=%-5s bin=%-42s effective=%s' \
      "$name" "$flag" "${bin:-(missing)}" "$eff"
    if [[ -n "$reason" ]]; then
      printf ' (%s)' "$reason"
    fi
    printf '\n'
  done
  echo
  echo "Apps (not spawnable)"
  local app
  app="$(find_app grok-bot)"
  printf '  %-8s %s\n' "grok-bot" "${app:-(missing)}"
  app="$(find_app cursor)"
  printf '  %-8s %s\n' "cursor" "${app:-(missing)}"
  if [[ -z "$(find_worker_bin cursor)" ]]; then
    echo "  Cursor GUI cannot be spawned. Install CLI:"
    echo "  curl https://cursor.com/install -fsS | bash"
  elif ! python3 -c 'import json,os,sys; d=json.load(open(os.path.expanduser("~/.cursor/cli-config.json"))); sys.exit(0 if (d.get("network") or {}).get("useHttp1ForAgent") is True else 1)' 2>/dev/null; then
    echo "  cursor: HTTP/2 agent transport is unstable; set network.useHttp1ForAgent=true in ~/.cursor/cli-config.json"
  fi
  if [[ -z "$(find_worker_bin opencode)" ]]; then
    echo "  OpenCode CLI missing:"
    echo "  curl -fsSL https://opencode.ai/install | bash"
  fi
  if [[ -z "$(find_worker_bin omp)" ]]; then
    echo "  OMP CLI missing:"
    echo "  curl -fsSL https://omp.sh/install | sh"
  fi
  if [[ -z "$(find_worker_bin pi)" ]]; then
    echo "  Pi CLI missing:"
    echo "  npm install -g @earendil-works/pi-coding-agent"
  fi
  if [[ -z "$(find_worker_bin agy)" ]]; then
    echo "  Antigravity CLI missing:"
    echo "  curl -fsSL https://antigravity.google/cli/install.sh | bash"
  fi
  if [[ -z "$(find_worker_bin devin)" ]]; then
    echo "  Devin CLI missing (child-only SWE-2 worker):"
    echo "  https://docs.devin.ai/cli"
  fi
  if [[ -z "$(find_worker_bin mimo)" ]]; then
    echo "  MiMo Code CLI missing: https://github.com/MiMo-AI/mimo-code"
  fi
  echo
  echo "Skill"
  local p proj_skill
  proj_skill="$(repo_root)/.agents/skills/delegate-harness/SKILL.md"
  if [[ -f "$proj_skill" ]]; then
    echo "  project: $proj_skill"
  else
    echo "  project: $proj_skill (missing — run: rig init)"
  fi
  for p in \
    "$HOME/.agents/skills/delegate-harness" \
    "$HOME/.grok/skills/delegate-harness" \
    "$HOME/.codex/skills/delegate-harness" \
    "$HOME/.config/opencode/skill/delegate-harness" \
    "$HOME/.omp/agent/skills/delegate-harness" \
    "$HOME/.pi/agent/skills/delegate-harness" \
    "$HOME/.gemini/antigravity-cli/skills/delegate-harness"
  do
    if [[ -L "$p" ]]; then
      echo "  $p -> $(readlink "$p")"
    elif [[ -e "$p" ]]; then
      echo "  $p (present, not a symlink)"
    else
      echo "  $p (missing — run: rig setup)"
    fi
  done
  echo
  echo "Scripts"
  if [[ -x "$runw" || -f "$runw" ]]; then
    echo "  run-worker: $runw (ok)"
  else
    echo "  run-worker: $runw (missing)"
    echo "Rig itself is broken. Re-run: rig setup" >&2
    exit 1
  fi
  local cat_py cat_out
  cat_py="$(py_script catalog.py)"
  if [[ -f "$cat_py" ]]; then
    cat_out="$(python3 "$cat_py" doctor 2>/dev/null || true)"
    if [[ -n "$cat_out" ]]; then
      echo
      printf '%s\n' "$cat_out"
    fi
  fi
  local route_py route_out route_rc=0
  route_py="$(py_script routing_policy.py)"
  if [[ -f "$route_py" ]]; then
    echo
    set +e
    route_out="$(python3 "$route_py" doctor --repo "$root" 2>&1)"
    route_rc=$?
    set -e
    if [[ -n "$route_out" ]]; then
      printf '%s\n' "$route_out"
    fi
    if [[ "$route_rc" -ne 0 ]]; then
      exit "$route_rc"
    fi
  fi
  echo
  echo "MCP"
  local mcp_name mcp_reason mcp_bin mcp_schema
  echo "  Cursor uses guarded job-scoped plugin MCP; non-Rig MCP calls fail the job"
  for mcp_name in grok codex claude opencode omp pi agy devin mimo cursor; do
    mcp_reason="$(worker_mcp_reason "$mcp_name" 2>/dev/null || true)"
    mcp_bin="$(find_worker_bin "$mcp_name")"
    case "$mcp_name" in
      grok|codex) mcp_schema="mcp_servers.rig" ;;
      opencode) mcp_schema="mcp.rig" ;;
      omp|pi|agy) mcp_schema="mcpServers.rig" ;;
      claude) mcp_schema="job mcp.json" ;;
      devin) mcp_schema="job .devin/mcp_config.local.json" ;;
      mimo) mcp_schema="job-scoped MIMOCODE_CONFIG_DIR" ;;
      *) mcp_schema="mcp" ;;
    esac
    if [[ -z "$mcp_reason" ]]; then
      echo "  $mcp_name: ready ($mcp_schema; fully quit once to load tools)"
    elif [[ "$mcp_name" == "cursor" ]]; then
      echo "  cursor: not ready ($mcp_reason)"
    else
      echo "  $mcp_name: unavailable ($mcp_reason)"
    fi
  done
  local cu_py
  cu_py="$(py_script computer_use.py)"
  if [[ -f "$cu_py" ]]; then
    echo
    python3 "$cu_py" doctor --repo "$root" || true
  fi
  local bsk_py
  bsk_py="$(py_script browser_skill.py)"
  if [[ -f "$bsk_py" ]]; then
    echo
    python3 "$bsk_py" doctor --repo "$root" || true
  fi
  echo
  echo "Watch"
  echo "  board:  rig tui"
  echo "  list:   rig jobs"
  echo "  wait:   rig job wait [id ...]   (blocks until ASK or result; exit 2 = ASK — you allow/deny)"
  echo "  log:    rig job log [id] -f"
  echo "  memory: rig memory   |   rig memory add \"fact\""
  echo "  slash:  /rig /queue in Grok, Codex, OpenCode, OMP, Pi, or agy (Codex: /plugins Rig Queue + /hooks trust; mid-wait: rig tui e)"
  echo "  pick:   rig pick --case \"task\"   (agent chooses model; do not ask the user)"
}

cmd_status() {
  local live pref name effs jobs
  parse_harness "$(harness_path)"
  echo "project: $(project_state)"
  live="$(live_parent)"
  pref="$HARNESS_PARENT"
  effs=""
  for name in "${RIG_WORKERS[@]}"; do
    if effective_worker "$name"; then
      effs+="$name "
    fi
  done
  jobs=0
  if [[ -d "$(repo_root)/.rig/jobs" ]]; then
    jobs="$(command find "$(repo_root)/.rig/jobs" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
  fi
  echo "parent live=${live:-(none)} preferred=${pref:-(none)}"
  echo "effective: ${effs:-none}"
  echo "jobs: $jobs"
  local jp mp thread last
  jp="$(py_script jobs.py)"
  if [[ -f "$jp" ]]; then
    thread="$(python3 "$jp" thread 2>/dev/null || true)"
    [[ -n "$thread" ]] && echo "thread: $thread"
  fi
  mp="$(py_script memory.py)"
  if [[ -f "$mp" ]]; then
    echo "memory: $(python3 "$mp" count 2>/dev/null || echo 0) facts"
  fi
  last="$(repo_root)/.rig/STATE.md"
  if [[ -f "$last" ]]; then
    echo "state:"
    command grep -E '^- (last_job|worker|status|summary):' "$last" | sed 's/^/  /'
  fi
  if [[ -f "$jp" ]]; then
    python3 "$jp" list
  fi
}

cmd_jobs() {
  python3 "$(py_script jobs.py)" list "$@"
}

cmd_timeline() {
  python3 "$(py_script task_timeline.py)" "$@" --repo "$(repo_root)"
}

cmd_workflows() {
  python3 "$(py_script workflow.py)" list "$@" --repo "$(repo_root)"
}

cmd_workflow() {
  if [[ "${1:-}" == recipe ]]; then
    shift
    python3 -B "$(py_script workflow_recipes.py)" "$@" --repo "$(repo_root)"
    return
  fi
  python3 "$(py_script workflow.py)" "$@" --repo "$(repo_root)"
}

cmd_queue() {
  python3 "$(py_script work_queue.py)" "$@"
}

cmd_memory() {
  local sub="${1:-show}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$sub" in
    replace|remove)
      python3 "$(py_script memory.py)" "$sub" "$@"
      ;;
    show|count)
      python3 "$(py_script memory.py)" "$sub"
      ;;
    add)
      local fact="$*"
      if [[ -z "$fact" && ! -t 0 ]]; then
        fact="$(cat)"
      fi
      if [[ -z "$fact" ]]; then
        echo "usage: rig memory add \"standing fact\"" >&2
        exit 2
      fi
      python3 "$(py_script memory.py)" add "$fact"
      ;;
    -h|--help|help)
      echo "usage: rig memory [show|add \"standing fact\"]" >&2
      exit 2
      ;;
    *)
      python3 "$(py_script memory.py)" add "$sub $*"
      ;;
  esac
}

cmd_tui() {
  python3 "$(py_script rig_tui.py)" "$@"
}

effective_csv() {
  local name out=""
  for name in "${RIG_WORKERS[@]}"; do
    if effective_worker "$name"; then
      out+="${out:+,}$name"
    fi
  done
  printf '%s\n' "$out"
}

cmd_pick() {
  local role="" case_text="" exclude="" json=0 parent_model="" parent_effort=""
  local review_args=() extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --explain) extra_args+=(--explain); shift ;;
      --writer-job-id|--writer-cli|--writer-model|--writer-provider|--review-mode|--complexity|--risk|--uncertainty|--assessment-reason|--policy-mode|--task-domain|--research-source)
        [[ $# -ge 2 ]] || { echo "rig pick: $1 needs a value" >&2; exit 2; }
        if [[ "$1" == --writer-* || "$1" == --review-mode ]]; then
          review_args+=("$1" "$2")
        else
          extra_args+=("$1" "$2")
        fi
        shift 2
        ;;
      --case)
        case_text="${2:-}"
        shift 2
        ;;
      --exclude)
        exclude="${2:-}"
        shift 2
        ;;
      --parent-model|--parent-effort)
        [[ $# -ge 2 ]] || { echo "rig pick: $1 needs a value" >&2; exit 2; }
        if [[ "$1" == "--parent-model" ]]; then parent_model="$2"; else parent_effort="$2"; fi
        shift 2
        ;;
      --help|-h)
        echo "usage: rig pick [explore|mini|bulk|implement|hard|review|verify|stay] [--case TEXT] [--exclude NAME] [--parent-model MODEL] [--parent-effort EFFORT] [--task-domain DOMAIN] [--research-source REPO_FILE] [--complexity L] [--risk L] [--uncertainty L] [--explain] [--json]" >&2
        exit 2
        ;;
      --*)
        echo "rig pick: unknown flag $1" >&2
        exit 2
        ;;
      *)
        role="$1"
        shift
        ;;
    esac
  done
  local args=(pick --live "$(live_parent)" --effective "$(effective_csv)" --role "$role" --case "$case_text")
  [[ -n "$exclude" ]] && args+=(--exclude "$exclude")
  [[ -n "$parent_model" ]] && args+=(--parent-model "$parent_model")
  [[ -n "$parent_effort" ]] && args+=(--parent-effort "$parent_effort")
  [[ "$json" -eq 1 ]] && args+=(--json)
  if [[ ${#review_args[@]} -gt 0 ]]; then args+=("${review_args[@]}"); fi
  if [[ ${#extra_args[@]} -gt 0 ]]; then args+=("${extra_args[@]}"); fi
  python3 "$(py_script route.py)" "${args[@]}" --repo "$(repo_root)"
}

cmd_session() {
  local role="" case_text="" exclude="" json=0 compact=0 terminal_limit=10 parent_model="" parent_effort=""
  local review_args=() extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --compact) compact=1; shift ;;
      --explain) extra_args+=(--explain); shift ;;
      --writer-job-id|--writer-cli|--writer-model|--writer-provider|--review-mode|--complexity|--risk|--uncertainty|--assessment-reason|--policy-mode|--task-domain|--research-source)
        [[ $# -ge 2 ]] || { echo "rig session: $1 needs a value" >&2; exit 2; }
        if [[ "$1" == --writer-* || "$1" == --review-mode ]]; then
          review_args+=("$1" "$2")
        else
          extra_args+=("$1" "$2")
        fi
        shift 2
        ;;
      --terminal-limit|--parent-model|--parent-effort)
        [[ $# -ge 2 ]] || { echo "rig session: $1 needs a value" >&2; exit 2; }
        case "$1" in
          --terminal-limit) terminal_limit="$2" ;;
          --parent-model) parent_model="$2" ;;
          --parent-effort) parent_effort="$2" ;;
        esac
        shift 2
        ;;
      --case)
        case_text="${2:-}"
        shift 2
        ;;
      --role)
        role="${2:-}"
        shift 2
        ;;
      --exclude)
        exclude="${2:-}"
        shift 2
        ;;
      --help|-h)
        echo "usage: rig session [--role KIND] [--case TEXT] [--exclude NAME] [--compact] [--terminal-limit 0..100] [--parent-model MODEL] [--parent-effort EFFORT] [--task-domain DOMAIN] [--research-source REPO_FILE] [--complexity L] [--risk L] [--uncertainty L] [--explain] [--json]" >&2
        exit 2
        ;;
      --*)
        echo "rig session: unknown flag $1" >&2
        exit 2
        ;;
      *)
        role="$1"
        shift
        ;;
    esac
  done
  local args=(--session --repo "$(repo_root)" --role "$role" --case "$case_text" --exclude "$exclude")
  args+=(--terminal-limit "$terminal_limit")
  [[ "$compact" -eq 1 ]] && args+=(--compact)
  [[ -n "$parent_model" ]] && args+=(--parent-model "$parent_model")
  [[ -n "$parent_effort" ]] && args+=(--parent-effort "$parent_effort")
  [[ "$json" -eq 1 ]] && args+=(--json)
  if [[ ${#review_args[@]} -gt 0 ]]; then args+=("${review_args[@]}"); fi
  if [[ ${#extra_args[@]} -gt 0 ]]; then args+=("${extra_args[@]}"); fi
  python3 "$(py_script rig_mcp.py)" "${args[@]}"
}

cmd_routing() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    report)
      python3 "$(py_script routing_report.py)" --repo "$(repo_root)" "$@"
      ;;
    engine)
      local engine="${1:-}"
      [[ "$engine" == "local" || "$engine" == "jev" ]] || { echo "usage: rig routing engine local|jev" >&2; exit 2; }
      python3 "$(py_script jev_settings.py)" project --repo "$(repo_root)" --engine "$engine"
      ;;
    objective)
      local objective="${1:-}"
      case "$objective" in quality|balanced|speed|cost) ;; *) echo "usage: rig routing objective quality|balanced|speed|cost" >&2; exit 2 ;; esac
      python3 "$(py_script jev_settings.py)" project --repo "$(repo_root)" --objective "$objective"
      ;;
    *)
      echo "usage: rig routing report [--days N] [--json] | engine local|jev | objective quality|balanced|speed|cost" >&2
      exit 2
      ;;
  esac
}

cmd_billing() {
  local sub="${1:-}"
  case "$sub" in
    import|sync|report)
      python3 "$(py_script billing_ledger.py)" --repo "$(repo_root)" "$@"
      ;;
    *)
      echo "usage: rig billing import [--file PATH] [--scope NAME] [--dry-run] [--json]" >&2
      echo "       rig billing sync openai|anthropic [--file PATH] [--scope NAME] [--dry-run] [--validate] [--network] [--json]" >&2
      echo "       rig billing report [--scope NAME] [--json]" >&2
      exit 2
      ;;
  esac
}

cmd_benchmark() {
  python3 "$(py_script benchmark_reporting.py)" --repo "$(repo_root)" "$@"
}

cmd_use() {
  local who="${1:-}"
  case "$who" in
    codex|grok|opencode|omp|pi|agy) ;;
    *)
      echo "usage: rig use codex|grok|opencode|omp|pi|agy" >&2
      exit 2
      ;;
  esac
  ensure_harness
  rig_set_toml_key "$(harness_path)" "" "parent" "\"$who\""
  echo "preferred parent = $who"
}

cmd_parent() {
  echo "rig parent is gone. Parent model is chosen in the CLI. Worker models come from rig pick. Never spawn Sol/Astra/Fable as a child." >&2
  exit 2
}

cmd_workers() {
  [[ $# -ge 1 ]] || {
    echo "usage: rig workers grok=on|off claude=on|off codex=on|off cursor=on|off opencode=on|off omp=on|off pi=on|off agy=on|off devin=on|off mimo=on|off" >&2
    exit 2
  }
  ensure_harness
  local spec name val bool
  for spec in "$@"; do
    name="${spec%%=*}"
    val="${spec#*=}"
    case "$name" in
      grok|claude|codex|cursor|opencode|omp|pi|agy|devin|mimo) ;;
      *)
        echo "rig workers: unknown worker '$name'" >&2
        exit 2
        ;;
    esac
    case "$val" in
      on|true) bool="true" ;;
      off|false) bool="false" ;;
      *)
        echo "rig workers: use on|off (got $val)" >&2
        exit 2
        ;;
    esac
    rig_set_toml_key "$(harness_path)" "workers" "$name" "$bool"
    echo "$name = $bool"
  done
}

cmd_prune() {
  local jobs
  jobs="$(repo_root)/.rig/jobs"
  if [[ ! -d "$jobs" ]]; then
    echo "no jobs dir"
    return 0
  fi
  python3 - "$jobs" "$(py_script jobs.py)" <<'PY'
import json
import pathlib
import shutil
import sys
import time

root = pathlib.Path(sys.argv[1])
scripts = pathlib.Path(sys.argv[2]).resolve().parent
rig_jobs = None
try:
    if str(scripts) not in sys.path:
        sys.path.insert(0, str(scripts))
    import jobs as rig_jobs  # noqa: E402
except Exception:
    rig_jobs = None

now = time.time()
removed = 0
logs = 0
for p in list(root.iterdir()):
    if p.is_dir() and now - p.stat().st_mtime > 7 * 86400:
        shutil.rmtree(p)
        removed += 1
dirs = [p for p in root.iterdir() if p.is_dir()]
dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
for p in dirs[20:]:
    shutil.rmtree(p)
    removed += 1
for p in root.iterdir():
    if not p.is_dir():
        continue
    meta, log = p / "meta.json", p / "stdout.log"
    if not log.is_file():
        continue
    status = ""
    if meta.is_file():
        try:
            status = json.loads(meta.read_text()).get("status", "")
        except Exception:
            continue
    if status == "ok":
        if rig_jobs is not None:
            try:
                rig_jobs.persist_activity(p)
            except Exception:
                pass
        if (p / "activity.json").is_file():
            log.unlink()
            logs += 1
print(f"prune ok  removed={removed} logs_dropped={logs} kept={len([p for p in root.iterdir() if p.is_dir()])}")
PY
}

is_review_prompt() {
  local p="$1"
  [[ "$p" =~ ^[Rr]eview([[:space:]]|$) ]] || [[ "$p" =~ [[:space:]][Rr]eview[[:space:]] ]]
}

pick_worker() {
  local prompt="$1"
  local live name
  live="$(live_parent)"
  if [[ -z "$live" ]]; then
    live="$(preferred_parent)"
  fi
  if is_review_prompt "$prompt"; then
    for name in claude grok cursor opencode omp pi agy codex; do
      if [[ "$name" == "$live" ]]; then
        continue
      fi
      if effective_worker "$name"; then
        printf '%s\n' "$name"
        return 0
      fi
    done
    printf '%s\n' ""
    return 0
  fi
  if [[ "$live" != "grok" ]] && effective_worker grok; then
    printf '%s\n' "grok"
    return 0
  fi
  for name in claude cursor opencode omp pi agy codex; do
    if [[ "$name" == "$live" ]]; then
      continue
    fi
    if effective_worker "$name"; then
      printf '%s\n' "$name"
      return 0
    fi
  done
  printf '%s\n' ""
}

write_state() {
  local job="$1" worker="$2" status="$3" summary="$4"
  local state
  state="$(repo_root)/.rig/STATE.md"
  mkdir -p "$(dirname "$state")"
  cat > "$state" <<EOF
# STATE

Overwritten each run.

- last_job: $job
- worker: $worker
- status: $status
- summary: $summary
EOF
}


cmd_job() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ui-evidence)
      python3 "$(py_script ui_evidence.py)" --repo "$(repo_root)" "$@"
      ;;
    requirements|check|criterion|accept)
      python3 "$(py_script verification.py)" --repo "$(repo_root)" "$sub" "$@"
      ;;
    start|finish|record|close|reconcile|recover-parent-write|break-glass-close|show|log|allow|deny|cancel|wait|message)
      python3 "$(py_script jobs.py)" "$sub" "$@" --repo "$(repo_root)"
      ;;
    *)
      echo "usage: rig job start|finish|record|close|reconcile|recover-parent-write|break-glass-close|requirements|ui-evidence|check|criterion|accept|show|log|allow|deny|cancel|wait|message [arguments]" >&2
      return 2
      ;;
  esac
}

cmd_run() {
  local prompt="${*:-}"
  if [[ -z "$prompt" ]]; then
    echo "usage: rig run \"prompt\"" >&2
    exit 2
  fi
  local root harness
  root="$(repo_root)"
  harness="$(harness_path)"
  if [[ ! -f "$harness" ]]; then
    echo "rig run: missing $harness — run: rig init" >&2
    exit 1
  fi
  parse_harness "$harness"
  local job brief wrapper choice worker
  job="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$root/.rig/jobs/$job"
  brief="$root/.rig/jobs/$job/brief.md"
  {
    printf '%s\n\n' "$WORKER_PREAMBLE"
    printf '%s\n' "$prompt"
  } > "$brief"

  choice="$(python3 "$(py_script route.py)" pick --live "$(live_parent)" --effective "$(effective_csv)" --case "$prompt" --json)"
  local spawn model effort kind
  worker="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("worker",""))')"
  spawn="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("spawn",""))')"
  model="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("model",""))')"
  effort="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("effort",""))')"
  kind="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("kind",""))')"

  local parent_writes
  parent_writes="$(printf '%s\n' "$choice" | python3 -c 'import json,sys; print("true" if json.load(sys.stdin).get("parent_writes") else "")')"
  if [[ "$spawn" == "stay" ]]; then
    echo "parent keeps this (ask / plan / advise / vision / computer-use / chrome-profile / Figma). Do it here. Do not spawn a clicker."
    echo "$choice"
    write_state "$job" "${worker:-parent}" "ok" "parent keeps this; do not spawn a clicker"
    exit 0
  fi
  if [[ "$spawn" == "native" && "$parent_writes" == "true" ]]; then
    echo "parent_writes: register listed files with rig job start --json before editing, then authenticated finish/check/accept. Do not spawn a second same-CLI session."
    echo "$choice"
    write_state "$job" "${worker:-parent}" "ok" "parent_writes native implement/hard"
    exit 0
  fi
  if [[ "$spawn" != "run-worker" || -z "$worker" ]]; then
    echo "no effective cross-CLI worker. Use cheaper same-CLI workers. That is success."
    echo "$choice"
    write_state "$job" "none" "ok" "no effective cross-CLI worker; use cheap same-CLI workers"
    exit 0
  fi

  wrapper="$(rig_home)/scripts/run-worker.sh"
  if [[ ! -f "$wrapper" ]]; then
    wrapper="$(rig_source_root)/scripts/run-worker.sh"
  fi
  export RIG_ROLE="${kind:-implement}"
  export RIG_MODEL="$model"
  export RIG_EFFORT="$effort"
  local rc=0
  set +e
  "$wrapper" "$worker" "$job" "$brief"
  rc=$?
  set -e
  local result="$root/.rig/jobs/$job/result.json" status="unknown" summary=""
  if [[ -f "$result" ]] && command -v python3 >/dev/null 2>&1; then
    status="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status",""))' "$result")"
    summary="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("summary",""))' "$result")"
  fi
  write_state "$job" "$worker" "$status" "$summary"
  echo "job $job worker=$worker status=$status"
  echo "result: $result"
  exit "$rc"
}

main() {
  local cmd="${1:-}"
  shift || true
  if [[ -e "$(rig_home)/updates/pending.json" || -L "$(rig_home)/updates/pending.json" ]]; then
    case "$cmd" in update|help|-h|--help|"") ;; *)
      echo "rig: pending runtime update; use rig update --status or rig update --recover before other commands" >&2
      return 1 ;;
    esac
  fi
  if [[ "$cmd" == "setup" || "$cmd" == "init" ]] && [[ "${RIG_INSTALL_TRANSACTION:-}" != "1" ]] && command -v python3 >/dev/null 2>&1; then
    local repo_arg="-"
    [[ "$cmd" != "init" ]] || repo_arg="$(repo_root)"
    python3 "$(rig_source_root)/scripts/ui_install.py" transaction "$(rig_home)" "$(rig_source_root)" "$repo_arg" bash "${BASH_SOURCE[0]}" "$cmd" "$@"
    return $?
  fi
  case "$cmd" in
    on) cmd_project_toggle on; return ;;
    off) cmd_project_toggle off; return ;;
  esac
  case "$cmd" in init|setup|update|status|doctor|jobs|tui|memory|timeline|recovery|task|workflows|workflow|queue|routing|billing|help|-h|--help|"") ;; *) project_guard || return ;; esac
  case "$cmd" in
    ui) python3 "$(py_script rig_ui.py)" "$@" ;;
    uninstall) python3 "$(py_script ui_install.py)" "$@" ;;
    setup) cmd_setup "$@" ;;
    update) cmd_update "$@" ;;
    init) cmd_init "$@" ;;
    doctor) cmd_doctor "$@" ;;
    status) cmd_status "$@" ;;
    use) cmd_use "$@" ;;
    parent) cmd_parent "$@" ;;
    workers) cmd_workers "$@" ;;
    computer-use|computer_use)
      local cu_sub="${1:-status}"
      shift || true
      case "$cu_sub" in
        status|setup|on|off|doctor|unlock|serve) ;;
        -h|--help|help)
          echo "usage: rig computer-use [status|setup|on|off|doctor|unlock|serve]" >&2
          exit 2
          ;;
        *)
          echo "usage: rig computer-use [status|setup|on|off|doctor|unlock|serve]" >&2
          exit 2
          ;;
      esac
      if [[ "$cu_sub" == "on" || "$cu_sub" == "off" || "$cu_sub" == "unlock" ]]; then
        ensure_harness
      fi
      python3 "$(py_script computer_use.py)" "$cu_sub" --repo "$(repo_root)"
      ;;
    browser-skill|browser_skill)
      local bsk_sub="${1:-status}"
      shift || true
      case "$bsk_sub" in
        status|setup|on|off|doctor) ;;
        -h|--help|help)
          echo "usage: rig browser-skill [status|setup|on|off|doctor]" >&2
          exit 2
          ;;
        *)
          echo "usage: rig browser-skill [status|setup|on|off|doctor]" >&2
          exit 2
          ;;
      esac
      if [[ "$bsk_sub" == "on" || "$bsk_sub" == "off" ]]; then
        ensure_harness
      fi
      python3 "$(py_script browser_skill.py)" "$bsk_sub" --repo "$(repo_root)"
      ;;
    prune) cmd_prune "$@" ;;
    run) cmd_run "$@" ;;
    jobs) cmd_jobs "$@" ;;
    timeline) cmd_timeline "$@" ;;
    workflows) cmd_workflows "$@" ;;
    workflow) cmd_workflow "$@" ;;
    context) python3 "$(py_script context_packages.py)" "$@" --repo "$(repo_root)" ;;
    recovery) python3 "$(py_script recovery_guide.py)" "$@" --repo "$(repo_root)" ;;
    task) python3 "$(py_script task_preparation.py)" "$@" --repo "$(repo_root)" ;;
    queue) cmd_queue "$@" ;;
    tui) cmd_tui "$@" ;;
    memory) cmd_memory "$@" ;;
    job) cmd_job "$@" ;;
    pick) cmd_pick "$@" ;;
    routing) cmd_routing "$@" ;;
    provider)
      [[ "${1:-}" == "jev" ]] || { echo "usage: rig provider jev setup|status|remove" >&2; exit 2; }
      shift
      python3 "$(py_script jev_settings.py)" "$@"
      ;;
    billing) cmd_billing "$@" ;;
    benchmark) cmd_benchmark "$@" ;;
    session) cmd_session "$@" ;;
    diagram) python3 "$(py_script diagram_preview.py)" "$@" ;;
    -h|--help|help|"") usage ;;
    *)
      echo "rig: unknown command '$cmd'" >&2
      usage
      ;;
  esac
}

main "$@"
